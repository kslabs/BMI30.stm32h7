+        (uint32_t)(now_ms - lcd_bg.transfer_started_ms) >= LCD_BOOT_VISIBLE_MS) {
+        lcd_bg.initialized = LCD_RUNNING;
+    }
+    return (uint8_t)(lcd_bg.initialized == LCD_RUNNING);
