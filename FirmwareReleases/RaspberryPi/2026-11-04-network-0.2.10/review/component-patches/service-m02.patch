+def routing_status(state, now_mono=None, now_wall=None):
+    """Freshness of route observation only; group/fast-channel health is separate."""
+    result = dict(state)
+    now_mono = time.monotonic() if now_mono is None else now_mono
+    now_wall = time.time() if now_wall is None else now_wall
+    checked = state.get('checked_mono') if state.get('clock_mode') == 'monotonic-v2' else state.get('checked_at')
+    now = now_mono if state.get('clock_mode') == 'monotonic-v2' else now_wall
+    observed_age = max(0., now-checked) if isinstance(checked, (int, float)) and math.isfinite(checked) else None
+    stale = observed_age is None or observed_age > ROUTING_STALE_S or state.get('routing_tick_ok') is False
+    result.update(checked_age_s=observed_age, stale=stale)
+    if stale:
+        result.update(status='degraded', automatic=False)
+    return result
+
 
