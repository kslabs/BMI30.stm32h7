def _detector_latency_estimate(scope, settings):
    """Nominal acquisition budget: first pair plus C-1 fresh arrivals.

    An AVG_ROI output per ADC arrives at 2*f/STM32_N. The first pair costs
    two packet periods, subsequent checks each one new period: (C+1)*dt.
    From first qualifying pair to final confirmation is only (C-1)*dt.
    USB/OS stalls and signal-dependent threshold crossing are not included.
    """
    frequency = float(getattr(scope, 'freq_hz', 0) or 200)
    depth = max(1, int(getattr(scope, 'avg_n', 1) or 1)) if int(getattr(scope, 'stream_mode', 0)) == 2 else 1
    packet_ms = 1000.0*depth/(2.0*frequency) if frequency > 0 else None
    counts = [max(1, int(settings.get('det_confirm_count'+str(ch), 2) or 2)) for ch in (0, 1)]
    active = [bool(settings.get('det_channel_enabled'+str(ch), True)) for ch in (0, 1)]
    intervals = [(count-1)*packet_ms if packet_ms is not None else None for count in counts]
    spans = [(count+1)*packet_ms if packet_ms is not None else None for count in counts]
    selected = [value for value, enabled in zip(spans, active) if enabled and value is not None]
    return {'estimated_ms': max(selected) if selected else None,
            'channel_confirmation_ms': intervals, 'full_input_ms': spans,
            'packet_period_ms': packet_ms, 'first_pair_ms': 2*packet_ms if packet_ms is not None else None,
            'confirm_counts': counts, 'definition': 'first_pair_plus_fresh_arrivals',
            'processing_ms': dict(getattr(scope, '_rt_det_latency', {})).get('total_ms'),
            'detector_rpi_depth': int(getattr(scope, 'rpi_avg_n', 1)) if int(getattr(scope, 'stream_mode', 0)) == 2 else 1,
            'display_rpi_depth': int(getattr(scope, 'rpi_avg_n', 1)),
            'rpi_history_span_ms': (int(getattr(scope, 'rpi_avg_n', 1))-1)*2*packet_ms if packet_ms is not None else None,
            'rpi_mean_data_age_ms': (int(getattr(scope, 'rpi_avg_n', 1))-1)*packet_ms if packet_ms is not None else None,
            'hard_limit_ms': None}


