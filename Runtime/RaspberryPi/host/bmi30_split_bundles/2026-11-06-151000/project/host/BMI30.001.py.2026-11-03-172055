    @staticmethod
    def _fire_frame_sources(scope: Any, fire_seq0: int, fire_seq1: int, review_seq: int = 0) -> dict[str, Any]:
        frame0 = ScopeApi._fire_frame_source(scope, 0, fire_seq0)
        frame1 = ScopeApi._fire_frame_source(scope, 1, fire_seq1)
        if review_seq:
            saved = getattr(getattr(scope, '_det_review_history', None), 'events', {}).get(int(review_seq))
            frame0 = saved if saved is not None and saved.get('fire_channel') == 0 else None
            frame1 = saved if saved is not None and saved.get('fire_channel') == 1 else None

        def _value(frame: Any, key: str) -> Any:
            return frame.get(key) if isinstance(frame, dict) else None

        id0 = int(_value(frame0, "detector_frame_id") or -1)
        id1 = int(_value(frame1, "detector_frame_id") or -1)
        same_frame = bool(frame0 is not None and frame1 is not None and id0 >= 0 and id0 == id1)
        if frame0 is not None and frame1 is not None and not same_frame:
            ts0 = float(_value(frame0, "fire_timestamp") or 0.0)
            ts1 = float(_value(frame1, "fire_timestamp") or 0.0)
            anchor = frame1 if ts1 > ts0 else frame0
        else:
            anchor = frame0 if frame0 is not None else frame1
        anchor_channel = int(_value(anchor, "fire_channel") if _value(anchor, "fire_channel") is not None else -1)
        matched0 = bool(frame0 is not None and (frame0 is anchor or same_frame))
        matched1 = bool(frame1 is not None and (frame1 is anchor or same_frame))

        raw = {
            "data0_even": _value(anchor, "data0_even"),
            "data0_odd": _value(anchor, "data0_odd"),
            "data1_even": _value(anchor, "data1_even"),
            "data1_odd": _value(anchor, "data1_odd"),
        }
        if raw["data0_even"] is None:
            raw["data0_even"] = _value(frame0, "even")
        if raw["data0_odd"] is None:
            raw["data0_odd"] = _value(frame0, "odd")
        if raw["data1_even"] is None:
            raw["data1_even"] = _value(frame1, "even")
        if raw["data1_odd"] is None:
            raw["data1_odd"] = _value(frame1, "odd")

        prod0 = _value(anchor, "product0")
        prod1 = _value(anchor, "product1")
        if prod0 is None:
            prod0 = _value(frame0, "product")
        if prod1 is None:
            prod1 = _value(frame1, "product")
        if prod0 is None:
            prod0 = ScopeApi._fire_product_source(scope, 0, fire_seq0)
        if prod1 is None:
            prod1 = ScopeApi._fire_product_source(scope, 1, fire_seq1)

        def _confirmation_products(frame: Any, final_product: Any, channel: int) -> list[Any]:
            try:
                products = list(frame.get("confirmation_products") or ()) if isinstance(frame, dict) else []
            except Exception:
                products = []
            if isinstance(anchor, dict) and f'confirmation_products{channel}' in anchor:
                products = list(anchor[f'confirmation_products{channel}'])
            products = [product for product in products if product is not None]
            if not products and final_product is not None:
                products = [final_product]
            return products

        return {
            **raw,
            "prod0": prod0,
            "prod1": prod1,
            "confirmation_products0": _confirmation_products(frame0, prod0, 0),
            "confirmation_products1": _confirmation_products(frame1, prod1, 1),
            "frame0": frame0,
            "frame1": frame1,
            "anchor": anchor,
            "anchor_channel": anchor_channel,
            "same_frame": same_frame,
            "matched0": matched0,
            "matched1": matched1,
        }

    @staticmethod
    def _review_frame_metadata(sources, n, scope, review_seq=0):
        anchor = sources.get('anchor') or {}
        frames = tuple(anchor.get('confirmation_frames') or ())
        result = {'review_seq': int(review_seq), 'event_snapshot': anchor.get('snapshot'),
                  'confirmation_steps': [f.get('decision') for f in frames],
                  'confirmation_context_count': len(frames),
                  'confirmation_pair_missing': sum(not f.get('synchronized') for f in frames)}
        def peak_info(product, raw=True, shift=0, noise_percent=None):
            if product is None:
                return None
            arr = np.asarray(product[:n], dtype=np.float64)
            if not arr.size or not np.all(np.isfinite(arr)):
                return None
            idx = int(np.argmax(arr));value = float(arr[idx])
            base = base_width_decision(arr, idx, getattr(scope, "_det_base_width_max", 24),
                getattr(scope, "_det_base_width_enabled", False), shift)
            return {'sample': idx, 'amplitude': value / _product_display_scale() if raw else value,
                    'raw_amplitude': value if raw else value * _product_display_scale(), 'base_width': base, 'sample_count': int(arr.size), 'noise_area_percent': int(noise_percent if noise_percent is not None else getattr(scope, '_det_noise_area_percent', 50))}
        for ch in (0, 1):
            product = sources.get(f'prod{ch}')
            raw = product is not None or bool(getattr(scope, 'xcorr_norm_enabled', False))
            if product is None and not anchor:
                product = getattr(scope, f'_xcorr_saved_prod{ch}', None)
                raw_count = int(getattr(scope, f'_rt_prod_raw_len{ch}', 0) or 0)
                if raw_count >= n and getattr(scope, f'_rt_prod_raw{ch}', None) is not None:
                    product = getattr(scope, f'_rt_prod_raw{ch}')[:n]
                    raw = True
            result[f'prod_peak{ch}'] = peak_info(product, raw, getattr(scope, f'_phase_shift_adc{ch}', 0) if not anchor else (anchor.get('shifts') or (0, 0))[ch], noise_percent=(anchor.get('snapshot') or {}).get('noise_area_percent') if anchor else None)
            snapshot = anchor.get('snapshot') or {}
            if anchor and ch == sources.get('anchor_channel') and result[f'prod_peak{ch}'] and snapshot.get('base_width'):
                result[f'prod_peak{ch}'].update(sample=snapshot['peak_index'], base_width=snapshot['base_width'])
            products = sources.get(f'confirmation_products{ch}', ())
            result[f'confirmation_peak_values{ch}'] = [peak_info(p) for p in products]
            # A reference trace is labelled as such; no asynchronous live gates are attached.
            result[f'reference_snapshot{ch}'] = None
            if anchor and ch != sources.get('anchor_channel') and product is not None:
                info = peak_info(product)
                result[f'reference_snapshot{ch}'] = {
                    'fired': False, 'reference_only': True, 'level': info['raw_amplitude'],
                    'peak_index': info['sample'], 'display_scale': _product_display_scale(),
                    'context_frames': len(products), 'context_required': len(frames),
                    'synchronized': bool(anchor.get('synchronized')),
                    'noise_avg': (anchor.get('noise_levels') or (None, None))[ch],
                    'event_timestamp': (anchor.get('snapshot') or {}).get('timestamp')}
        return result

    def frame(self, max_points: int = 600, fire_seq0: int = 0, fire_seq1: int = 0, review_seq: int = 0) -> dict[str, Any]:
        scope = self.scope
        max_points = max(16, min(4096, int(max_points)))
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        show_product = bool(selected_mode >= 6)
        data_lock, data_lock_acquired = self._try_data_lock(scope)
        if not data_lock_acquired:
            return self._busy_frame(scope)
        try:
            n = int(getattr(scope, "base_buf_len", 0) or 0)
            if n <= 0:
                return {"ok": True, "available": False, "base_buf_len": 0}
            n = min(n, int(getattr(scope, "max_samples", n) or n))
            step = max(1, int(np.ceil(float(n) / float(max_points))))
            fire_sources = self._fire_frame_sources(scope, fire_seq0, fire_seq1, review_seq)
            if (fire_seq0 or fire_seq1 or review_seq) and fire_sources['anchor'] is None:
                return {'ok': True, 'available': False, 'event_expired': True}
            fire_prod0 = fire_sources["prod0"]
            fire_prod1 = fire_sources["prod1"]
            confirm_products0 = fire_sources["confirmation_products0"]
            confirm_products1 = fire_sources["confirmation_products1"]
            normalization_peak0 = self._frame_product_group_peak([fire_prod0, *confirm_products0], n)
            normalization_peak1 = self._frame_product_group_peak([fire_prod1, *confirm_products1], n)
            exact_event_frame = fire_sources["anchor"] is not None

            def _arr(
                name: str,
                source_values: Any = None,
                source_raw_product: bool = False,
                normalization_peak: float | None = None,
            ) -> list[int]:
                if exact_event_frame and source_values is None:
                    return []
                try:
                    vals = (
                        self._frame_array_values(
                            scope,
                            source_values,
                            name,
                            n,
                            step,
                            source_raw_product=source_raw_product,
                            normalization_peak=normalization_peak,
                        )
                        if source_values is not None
                        else self._frame_values(scope, name, n, step)
                    )
                    return vals.astype(np.uint16).astype(int).tolist()
                except Exception:
                    return []

            x = list(range(0, n, step))
            return {
                "ok": True,
                "available": True,
                "base_buf_len": n,
                "step": step,
                "x": x,
                "data0_even": _arr("data0_even", fire_sources["data0_even"]),
                "data0_odd": _arr("data0_odd", fire_sources["data0_odd"]),
                "prod0": _arr("_xcorr_saved_prod0", fire_prod0, fire_prod0 is not None, normalization_peak0) if show_product else [],
                "prod_confirm0": [
                    _arr("_xcorr_saved_prod0", product, True, normalization_peak0)
                    for product in confirm_products0
                ] if show_product else [],
                "prod_norm0": self._frame_norm_stats(scope, "_xcorr_saved_prod0", n, step, fire_prod0, normalization_peak0) if show_product else None,
                "data1_even": _arr("data1_even", fire_sources["data1_even"]),
                "data1_odd": _arr("data1_odd", fire_sources["data1_odd"]),
                "prod1": _arr("_xcorr_saved_prod1", fire_prod1, fire_prod1 is not None, normalization_peak1) if show_product else [],
                "prod_confirm1": [
                    _arr("_xcorr_saved_prod1", product, True, normalization_peak1)
                    for product in confirm_products1
                ] if show_product else [],
                "prod_norm1": self._frame_norm_stats(scope, "_xcorr_saved_prod1", n, step, fire_prod1, normalization_peak1) if show_product else None,
                "fire_product_seq0": int(fire_seq0) if fire_prod0 is not None and fire_sources["matched0"] else 0,
                "fire_product_seq1": int(fire_seq1) if fire_prod1 is not None and fire_sources["matched1"] else 0,
                "fire_frame_seq0": int(fire_seq0) if fire_sources["matched0"] else 0,
                "fire_frame_seq1": int(fire_seq1) if fire_sources["matched1"] else 0,
                "exact_event_channel": int(fire_sources["anchor_channel"]),
                "same_detector_frame": bool(fire_sources["same_frame"]),
                "exact_event_frame": bool(exact_event_frame),
                **self._review_frame_metadata(fire_sources, n, scope, review_seq),
                "last_frame_t": float(getattr(scope, "last_frame_t", 0.0) or 0.0),
            }
        finally:
            try:
                if data_lock is not None and data_lock_acquired:
                    data_lock.release()
            except Exception:
                pass

    def frame_binary(
        self,
        max_points: int = 600,
        channels: str = "both",
        since: float = 0.0,
        fire_seq0: int = 0,
        fire_seq1: int = 0,
        review_seq: int = 0,
    ) -> bytes:
        scope = self.scope
        max_points = max(16, min(4096, int(max_points)))
        channels = str(channels or "both").strip().lower()
        want_upper = channels not in {"lower", "l", "1", "adc1", "ch1"}
        want_lower = channels not in {"upper", "u", "0", "adc0", "ch0"}
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        show_product = bool(selected_mode >= 6)
        data_lock, data_lock_acquired = self._try_data_lock(scope)
        arrays: list[tuple[str, bytes]] = []
        if not data_lock_acquired:
            return self._pack_frame_binary(self._busy_frame(scope), arrays)
        try:
            n = int(getattr(scope, "base_buf_len", 0) or 0)
            frame_ts = float(getattr(scope, "last_frame_t", 0.0) or 0.0)
            if n <= 0:
                header = {"ok": True, "available": False, "base_buf_len": 0}
                return self._pack_frame_binary(header, arrays)
            fire_requested = int(fire_seq0 or 0) > 0 or int(fire_seq1 or 0) > 0 or int(review_seq or 0) > 0
            if not fire_requested and frame_ts > 0.0 and float(since or 0.0) >= frame_ts:
                header = {"ok": True, "available": False, "not_modified": True, "last_frame_t": frame_ts}
                return self._pack_frame_binary(header, arrays)
            n = min(n, int(getattr(scope, "max_samples", n) or n))
            step = max(1, int(np.ceil(float(n) / float(max_points))))
            count = int(len(range(0, n, step)))
            fire_sources = self._fire_frame_sources(scope, fire_seq0, fire_seq1, review_seq)
            if (fire_seq0 or fire_seq1 or review_seq) and fire_sources['anchor'] is None:
                return self._pack_frame_binary({'ok': True, 'available': False, 'event_expired': True}, [])
            fire_prod0 = fire_sources["prod0"]
            fire_prod1 = fire_sources["prod1"]
            confirm_products0 = fire_sources["confirmation_products0"]
            confirm_products1 = fire_sources["confirmation_products1"]
            normalization_peak0 = self._frame_product_group_peak([fire_prod0, *confirm_products0], n)
            normalization_peak1 = self._frame_product_group_peak([fire_prod1, *confirm_products1], n)
            exact_event_frame = fire_sources["anchor"] is not None
            confirmation_array_names0: list[str] = []
            confirmation_array_names1: list[str] = []

            def _arr_bytes(
                name: str,
                source_values: Any = None,
                source_raw_product: bool = False,
                normalization_peak: float | None = None,
            ) -> bytes:
                if exact_event_frame and source_values is None:
                    return b''
                try:
                    vals = (
                        self._frame_array_values(
                            scope,
                            source_values,
                            name,
                            n,
                            step,
                            source_raw_product=source_raw_product,
                            normalization_peak=normalization_peak,
                        )
                        if source_values is not None
                        else self._frame_values(scope, name, n, step)
                    ).astype(np.dtype("<u2"), copy=False)
                    return vals.tobytes(order="C")
                except Exception:
                    return b""

            if want_upper:
                arrays.append(("data0_even", _arr_bytes("data0_even", fire_sources["data0_even"])))
                arrays.append(("data0_odd", _arr_bytes("data0_odd", fire_sources["data0_odd"])))
                if show_product:
                    arrays.append(("prod0", _arr_bytes("_xcorr_saved_prod0", fire_prod0, fire_prod0 is not None, normalization_peak0)))
                    for index, product in enumerate(confirm_products0):
                        name = f"prod_confirm0_{index}"
                        payload = _arr_bytes("_xcorr_saved_prod0", product, True, normalization_peak0)
                        if payload:
                            arrays.append((name, payload))
                            confirmation_array_names0.append(name)
            if want_lower:
                arrays.append(("data1_even", _arr_bytes("data1_even", fire_sources["data1_even"])))
                arrays.append(("data1_odd", _arr_bytes("data1_odd", fire_sources["data1_odd"])))
                if show_product:
                    arrays.append(("prod1", _arr_bytes("_xcorr_saved_prod1", fire_prod1, fire_prod1 is not None, normalization_peak1)))
                    for index, product in enumerate(confirm_products1):
                        name = f"prod_confirm1_{index}"
                        payload = _arr_bytes("_xcorr_saved_prod1", product, True, normalization_peak1)
                        if payload:
                            arrays.append((name, payload))
                            confirmation_array_names1.append(name)
            header = {
                "ok": True,
                "available": True,
                "base_buf_len": n,
                "step": step,
                "count": count,
                "arrays": [name for name, payload in arrays if payload],
                "prod_norm0": self._frame_norm_stats(scope, "_xcorr_saved_prod0", n, step, fire_prod0, normalization_peak0) if show_product and want_upper else None,
                "prod_norm1": self._frame_norm_stats(scope, "_xcorr_saved_prod1", n, step, fire_prod1, normalization_peak1) if show_product and want_lower else None,
                "confirmation_product_arrays0": confirmation_array_names0,
                "confirmation_product_arrays1": confirmation_array_names1,
                "fire_product_seq0": int(fire_seq0) if fire_prod0 is not None and fire_sources["matched0"] else 0,
                "fire_product_seq1": int(fire_seq1) if fire_prod1 is not None and fire_sources["matched1"] else 0,
                "fire_frame_seq0": int(fire_seq0) if fire_sources["matched0"] else 0,
                "fire_frame_seq1": int(fire_seq1) if fire_sources["matched1"] else 0,
                "exact_event_channel": int(fire_sources["anchor_channel"]),
                "same_detector_frame": bool(fire_sources["same_frame"]),
                "exact_event_frame": bool(exact_event_frame),
                **self._review_frame_metadata(fire_sources, n, scope, review_seq),
                "last_frame_t": frame_ts,
            }
            arrays = [(name, payload) for name, payload in arrays if payload]
            return self._pack_frame_binary(header, arrays)
        finally:
            try:
                if data_lock is not None and data_lock_acquired:
                    data_lock.release()
            except Exception:
                pass

    @staticmethod
    def _pack_frame_binary(header: dict[str, Any], arrays: list[tuple[str, bytes]]) -> bytes:
        header_bytes = json.dumps(_json_safe(header), ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        pad = b"\0" if (len(header_bytes) % 2) else b""
        return b"BMF1" + len(header_bytes).to_bytes(4, "little") + header_bytes + pad + b"".join(payload for _name, payload in arrays)


