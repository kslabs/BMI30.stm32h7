def _dc_lightning_offset_metric(scope: Any) -> dict[str, Any]:
    """Measure the worst residual DC mean on RPi for lightning progress."""
    try:
        center = float(os.getenv("BMI30_DC_LIGHTNING_CENTER", "32767"))
    except Exception:
        center = 32767.0
    data_lock = getattr(scope, "data_lock", None)
    try:
        if data_lock is not None:
            data_lock.acquire()
        n = int(getattr(scope, "base_buf_len", 0) or 0)
        if n <= 0:
            return {"ready": False, "reason": "no_frame"}
        n = min(n, int(getattr(scope, "max_samples", n) or n))
        try:
            adc1_en, adc2_en = scope._adc_enable_flags()
        except Exception:
            adc1_en, adc2_en = True, True
        names: list[str] = []
        if adc1_en:
            names.extend(("data0_even", "data0_odd"))
        if adc2_en:
            names.extend(("data1_even", "data1_odd"))
        rows: list[dict[str, Any]] = []
        for name in names:
            arr = np.asarray(getattr(scope, name, [])[:n], dtype=np.float64).copy()
            finite = arr[np.isfinite(arr)]
            if finite.size <= 0:
                continue
            mean_value = float(np.mean(finite))
            rows.append({"name": name, "mean": mean_value, "offset": abs(mean_value - center)})
        if not rows:
            return {"ready": False, "reason": "no_active_data"}
        worst = max(rows, key=lambda row: float(row["offset"]))
        return {
            "ready": True,
            "center": center,
            "max_mean_off": float(worst["offset"]),
            "worst_name": str(worst["name"]),
            "frame_t": float(getattr(scope, "last_frame_t", 0.0) or 0.0),
            "rows": rows,
        }
    except Exception as exc:
        return {"ready": False, "reason": str(exc)}
    finally:
        try:
            if data_lock is not None:
                data_lock.release()
        except Exception:
            pass


def _apply_default_dc_config(
    scope: Any,
    mode: int | None = None,
    reason: str = "",
    profile: str | None = None,
    force: bool = False,
    cfg: dict[str, Any] | None = None,
) -> bool:
    stream = getattr(scope, "stream", None)
    if stream is None or not hasattr(stream, "set_dc_speed_ms"):
        return False
    expected = _expected_dc_config(profile=profile, mode=mode, cfg=cfg)
    try:
        stream_identity = id(stream)
        settle_ms = int(expected["settle_ms"])
        cached_same = (
            int(getattr(scope, "_host_dc_stream_identity", -1)) == stream_identity
            and int(getattr(scope, "_host_dc_settle_ms", -1)) == settle_ms
        )
        device_same = False
        if not cached_same and int(getattr(scope, "_host_dc_stream_identity", -1)) != stream_identity:
            # A mode switch may replace the Python stream object while STM32
            # keeps its DC value. Read it once so reconnect recovery still
            # restores a reset device, but never repeats an identical value.
            try:
                if hasattr(stream, "get_dc_config"):
                    readback = _dc_config_from_device(stream.get_dc_config())
                    device_same = bool(readback.get("available", False)) and int(readback.get("settle_ms", -1)) == settle_ms
            except Exception:
                device_same = False
        sent = not (cached_same or device_same)
        # ``force`` is retained in the signature for compatibility with older
        # call sites. It must never bypass numeric de-duplication.
        _ = force
        if sent:
            stream.set_dc_speed_ms(settle_ms)
            print(
                f"[DC] SET_DC_SPEED state={expected['state']} settle_ms={settle_ms} "
                f"reason={reason}",
                flush=True,
            )
        try:
            profile_s = str(expected["profile"])
            scope._host_dc_profile = profile_s
            scope._host_dc_state = profile_s
            scope._host_dc_settle_ms = settle_ms
            scope._host_dc_stream_identity = stream_identity
            if profile_s not in {"startup", "start", "boot_fast"}:
                scope._host_dc_desired_profile = profile_s
            scope._host_dc_profile_t = time.time()
        except Exception:
            pass
        return True
    except Exception as exc:
        print(f"[DC] default config apply failed reason={reason}: {exc}", flush=True)
        return False


