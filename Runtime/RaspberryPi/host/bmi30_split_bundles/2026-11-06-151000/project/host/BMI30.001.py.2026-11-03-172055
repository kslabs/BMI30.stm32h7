    @staticmethod
    def _frame_array_values(
        scope: Any,
        arr: Any,
        name: str,
        n: int,
        step: int,
        source_raw_product: bool = False,
        normalization_peak: float | None = None,
    ) -> np.ndarray:
        if arr is None:
            return np.zeros(0, dtype=np.uint16)
        vals = np.asarray(arr[:n:step])
        if name.startswith("_xcorr_saved_prod") and bool(getattr(scope, "xcorr_norm_enabled", False)):
            vals = vals.astype(np.float32, copy=False)
            if vals.size <= 0:
                return vals
            try:
                hi = float(normalization_peak)
            except Exception:
                hi = float("nan")
            if not np.isfinite(hi) or hi <= 1e-12:
                hi = float(np.max(vals))
            if not np.isfinite(hi) or hi <= 1e-12:
                return np.zeros(vals.shape, dtype=np.uint16)
            vals = vals * (65535.0 / hi)
            return np.clip(vals, 0.0, 65535.0).astype(np.uint16)
        if name.startswith("_xcorr_saved_prod") and bool(source_raw_product):
            vals = vals.astype(np.float32, copy=False)
            vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
            vals = vals / _product_display_scale()
            return np.clip(vals, 0.0, 65535.0).astype(np.uint16)
        if np.issubdtype(vals.dtype, np.integer):
            return np.clip(vals, 0, 65535).astype(np.uint16, copy=False)
        vals = vals.astype(np.float32, copy=False)
        vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
        return np.clip(vals, 0.0, 65535.0).astype(np.uint16)

    @staticmethod
    def _frame_values(scope: Any, name: str, n: int, step: int) -> np.ndarray:
        return ScopeApi._frame_array_values(scope, getattr(scope, name, None), name, n, step)

    @staticmethod
    def _frame_product_group_peak(products: Any, n: int) -> float | None:
        """Return one normalization peak shared by every product in a confirmation chain."""
        peak = 0.0
        try:
            values = tuple(products or ())
        except Exception:
            values = ()
        for product in values:
            if product is None:
                continue
            try:
                arr = np.asarray(product[:n], dtype=np.float64)
                arr = np.nan_to_num(arr, nan=0.0, posinf=0.0, neginf=0.0)
                if arr.size:
                    peak = max(float(peak), float(np.max(arr)))
            except Exception:
                continue
        return float(peak) if np.isfinite(peak) and peak > 1e-12 else None

    @staticmethod
    def _frame_norm_stats(
        scope: Any,
        name: str,
        n: int,
        step: int,
        source_values: Any = None,
        normalization_peak: float | None = None,
    ) -> dict[str, Any] | None:
        if not bool(getattr(scope, "xcorr_norm_enabled", False)):
            return None
        arr = source_values if source_values is not None else getattr(scope, name, None)
        if arr is None:
            return None
        try:
            vals = np.asarray(arr[:n:step], dtype=np.float64)
            vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
            if vals.size <= 0:
                return None
            lo = float(np.min(vals))
            hi = float(np.max(vals))
            span = hi - lo
            if not np.isfinite(span) or span <= 1e-12:
                scale = 0.0
            else:
                scale = float(65535.0 / span)
            det_min = lo
            det_max = hi
            det_span = span
            screen_per_det = float(65535.0 / det_span) if np.isfinite(det_span) and det_span > 1e-12 else 0.0
            try:
                display_scale = float(os.getenv("BMI30_PROD_SCALE", "") or _product_default_scale())
            except Exception:
                display_scale = _product_default_scale()
            if not np.isfinite(display_scale) or display_scale <= 0.0:
                display_scale = _product_default_scale()
            display_vals = np.clip(vals / display_scale, 0.0, 65535.0)
            display_min = float(np.min(display_vals))
            display_max = float(np.max(display_vals))
            display_span = float(display_max - display_min)
            try:
                shared_peak = float(normalization_peak)
            except Exception:
                shared_peak = float("nan")
            if not np.isfinite(shared_peak) or shared_peak <= 1e-12:
                shared_peak = float(hi)
                normalization_scope = "single-product"
            else:
                normalization_scope = "confirmation-group"
            normalization_display_max = float(np.clip(shared_peak / display_scale, 0.0, 65535.0))
            return {
                "min": lo,
                "max": hi,
                "span": float(span),
                "scale": scale,
                "det_min": float(det_min),
                "det_max": float(det_max),
                "det_span": float(det_span),
                "screen_per_det": screen_per_det,
                "det_unit": "raw-product",
                "display_min": display_min,
                "display_max": display_max,
                "display_span": display_span,
                "display_scale": float(display_scale),
                "normalization_peak": float(shared_peak),
                "normalization_display_max": float(normalization_display_max),
                "normalization_scope": normalization_scope,
            }
        except Exception:
            return None

    @staticmethod
    def _fire_product_source(scope: Any, channel: int, fire_seq: int) -> Any:
        ch = 0 if int(channel) == 0 else 1
        try:
            requested_seq = int(fire_seq)
            saved_seq = int(getattr(scope, "_web_det_fire_prod_seq0" if ch == 0 else "_web_det_fire_prod_seq1", 0) or 0)
        except Exception:
            return None
        if requested_seq <= 0:
            return None
        try:
            history = getattr(scope, "_web_det_fire_products0" if ch == 0 else "_web_det_fire_products1", None)
            if isinstance(history, dict):
                source = history.get(requested_seq)
                if source is not None:
                    return source
        except Exception:
            pass
        if requested_seq != saved_seq:
            return None
        return getattr(scope, "_web_det_fire_prod0" if ch == 0 else "_web_det_fire_prod1", None)

