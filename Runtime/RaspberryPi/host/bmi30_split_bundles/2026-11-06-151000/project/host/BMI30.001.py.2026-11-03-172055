    def status(self) -> dict[str, Any]:
        scope = self.scope
        stream = getattr(scope, "stream", None)
        connected = bool(stream is not None and not bool(getattr(stream, "disconnected", False)))
        communication_recovery = None
        if connected and hasattr(stream, "get_communication_recovery"):
            communication_recovery = stream.get_communication_recovery()
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        data_lock, data_lock_acquired = self._try_data_lock(scope)
        if not data_lock_acquired:
            return self._busy_status(connected, selected_mode)
        try:
            base_len = int(getattr(scope, "base_buf_len", 0) or 0)
            frame_ts = float(getattr(scope, "last_frame_t", 0.0) or 0.0)
            seq0_even = getattr(scope, "seq0_even", None)
            seq0_odd = getattr(scope, "seq0_odd", None)
            seq1_even = getattr(scope, "seq1_even", None)
            seq1_odd = getattr(scope, "seq1_odd", None)
        finally:
            try:
                if data_lock is not None and data_lock_acquired:
                    data_lock.release()
            except Exception:
                pass
        stream_stats: dict[str, Any] = {}
        if stream is not None:
            for key in (
                "rx_cnt_ch0",
                "rx_cnt_ch1",
                "seq_gap_ch0",
                "seq_gap_ch1",
                "seq_dup_ch0",
                "seq_dup_ch1",
                "crc_bad",
                "magic_bad",
                "host_rx_ack_fail",
            ):
                try:
                    stream_stats[key] = int(getattr(stream, key, 0) or 0)
                except Exception:
                    stream_stats[key] = 0
            try:
                stream_stats["queues"] = stream.get_buffer_depths()
            except Exception:
                stream_stats["queues"] = {}
            try:
                stream_stats["last_crc_bad_info"] = getattr(stream, "last_crc_bad_info", None)
            except Exception:
                stream_stats["last_crc_bad_info"] = None
        now = time.time()
        last_age = (now - frame_ts) if frame_ts > 0 else None
        try:
            det_settings = scope._detector_settings_snapshot()
        except Exception:
            det_settings = {
                "det_channel_enabled0": True,
                "det_channel_enabled1": True,
                "det_confirm_count0": int(getattr(scope, "_rt_det_confirm_count", 2) or 2),
                "det_confirm_count1": int(getattr(scope, "_rt_det_confirm_count", 2) or 2),
                "det_ratio0": float(getattr(scope, "_det_ratio", 2.0) or 2.0),
                "det_ratio1": float(getattr(scope, "_det_ratio", 2.0) or 2.0),
                "det_effective_ratio0": float(getattr(scope, "_det_ratio", 2.0) or 2.0),
                "det_effective_ratio1": float(getattr(scope, "_det_ratio", 2.0) or 2.0),
                "det_threshold_auto0": False,
                "det_threshold_auto1": False,
                "det_burst_gate0": True,
                "det_burst_gate1": True,
                "det_burst_blank_s0": 0.08,
                "det_burst_blank_s1": 0.08,
                "det_burst_max_ratio0": 8.0,
                "det_burst_max_ratio1": 8.0,
            }
        try:
            sound_settings = scope._sound_settings_snapshot()
        except Exception:
            sound_settings = {
                "enabled": bool(getattr(scope, "_sound_enabled", False)),
                "volume_percent": 100.0,
