def _queue_qt_call(fn: Any) -> None:
    try:
        _QT_CALL_QUEUE.put(fn)
    except Exception as exc:
        print(f"[BMI30.001] queue Qt call failed: {exc}", flush=True)


def _call_qt_later_s(delay_s: float, fn: Any) -> None:
    try:
        delay = max(0.0, float(delay_s))
    except Exception:
        delay = 0.0
    if delay <= 0.0:
        _queue_qt_call(fn)
        return
    try:
        timer = threading.Timer(delay, lambda: _queue_qt_call(fn))
        timer.daemon = True
        timer.start()
    except Exception:
        _queue_qt_call(fn)


class _SinglePendingQtCall:
    """Cancelable single-shot debounce whose callback is delivered on Qt."""

    def __init__(self, queue_fn: Any = _queue_qt_call, timer_factory: Any = threading.Timer) -> None:
        self._queue_fn = queue_fn
        self._timer_factory = timer_factory
        self._lock = threading.Lock()
        self._timer: Any = None
        self._generation = 0

    def cancel(self) -> int:
        with self._lock:
            self._generation += 1
            timer = self._timer
            self._timer = None
            if timer is not None:
                try:
                    timer.cancel()
                except Exception:
                    pass
            return int(self._generation)

    def schedule(self, delay_s: float, fn: Any) -> int:
        try:
            delay = max(0.0, float(delay_s))
        except Exception:
            delay = 0.0
        with self._lock:
            old_timer = self._timer
            if old_timer is not None:
                try:
                    old_timer.cancel()
                except Exception:
                    pass
            self._generation += 1
            generation = int(self._generation)
            timer = self._timer_factory(delay, lambda: self._timer_fired(generation, fn))
            try:
                timer.daemon = True
            except Exception:
                pass
            self._timer = timer
            timer.start()
            return generation

    def _timer_fired(self, generation: int, fn: Any) -> None:
        with self._lock:
            if int(generation) != int(self._generation):
                return
            self._timer = None
        try:
            self._queue_fn(lambda: self._deliver(generation, fn))
        except Exception:
            self._deliver(generation, fn)

    def _deliver(self, generation: int, fn: Any) -> None:
        with self._lock:
            if int(generation) != int(self._generation):
                return
        fn()

    def pending_count(self) -> int:
        with self._lock:
            return int(self._timer is not None)


def _start_qt_call_pump(qtcore: Any) -> None:
    global _QT_CALL_PUMP_STARTED
    with _QT_CALL_PUMP_LOCK:
        if _QT_CALL_PUMP_STARTED:
            return
        _QT_CALL_PUMP_STARTED = True

    def _pump() -> None:
        global _QT_CALL_PUMP_STARTED
        while True:
            try:
                fn = _QT_CALL_QUEUE.get_nowait()
            except queue.Empty:
                break
            try:
                fn()
            except Exception as exc:
                print(f"[BMI30.001] Qt queued call failed: {exc}", flush=True)
        try:
            qtcore.QTimer.singleShot(50, _pump)
        except Exception as exc:
            print(f"[BMI30.001] Qt call pump stopped: {exc}", flush=True)
            with _QT_CALL_PUMP_LOCK:
                _QT_CALL_PUMP_STARTED = False

    try:
        qtcore.QTimer.singleShot(50, _pump)
    except Exception as exc:
        print(f"[BMI30.001] Qt call pump start failed: {exc}", flush=True)
        with _QT_CALL_PUMP_LOCK:
            _QT_CALL_PUMP_STARTED = False


