def _dc_float(value: Any, default: float, minimum: float = 0.0, maximum: float = DC_SETTLE_MAX_S) -> float:
    try:
        val = float(value)
    except Exception:
        val = float(default)
    try:
        if not np.isfinite(val):
            val = float(default)
    except Exception:
        val = float(default)
    return float(max(float(minimum), min(float(maximum), val)))


def _load_default_dc_config() -> dict[str, Any]:
    try:
        with open(CONFIG_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f) or {}
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    source = payload.get("dc_config")
    if not isinstance(source, dict):
        source = {}
    acquisition_s = _dc_float(
        source.get("acquisition_settle_s", source.get("detect_settle_s", source.get("detect_initial_settle_s", 500.0))),
        500.0,
    )
    detection_s = _dc_float(source.get("detection_settle_s", source.get("fast_settle_s", 10000.0)), 10000.0)
    return {
        "work_settle_s": _dc_float(source.get("work_settle_s", 5.0), 5.0),
        "acquisition_settle_s": acquisition_s,
        "detection_settle_s": detection_s,
        "startup_settle_s": DC_FASTEST_SETTLE_S,
        "lightning_timeout_s": _dc_float(
            source.get("lightning_timeout_s", DC_LIGHTNING_DURATION_S),
            DC_LIGHTNING_DURATION_S,
            DC_LIGHTNING_TIMEOUT_MIN_S,
        ),
    }


def _save_default_dc_config(cfg: dict[str, Any]) -> None:
    try:
        path = CONFIG_JSON
        try:
            previous_stat = path.stat()
        except Exception:
            previous_stat = None
        try:
            with open(path, "r", encoding="utf-8") as f:
                payload = json.load(f) or {}
        except Exception:
            payload = {}
        if not isinstance(payload, dict):
            payload = {}
        work_s = _dc_float(cfg.get("work_settle_s", 5.0), 5.0)
        acquisition_s = _dc_float(
            cfg.get("acquisition_settle_s", cfg.get("detect_settle_s", 500.0)),
            500.0,
        )
        detection_s = _dc_float(
            cfg.get("detection_settle_s", cfg.get("fast_settle_s", 10000.0)),
            10000.0,
        )
        startup_s = DC_FASTEST_SETTLE_S
        lightning_timeout_s = _dc_float(
            cfg.get("lightning_timeout_s", DC_LIGHTNING_DURATION_S),
            DC_LIGHTNING_DURATION_S,
            DC_LIGHTNING_TIMEOUT_MIN_S,
        )
        payload["dc_config"] = {
            "work_settle_s": work_s,
            "acquisition_settle_s": acquisition_s,
            "detection_settle_s": detection_s,
            "startup_settle_s": startup_s,
            "lightning_timeout_s": lightning_timeout_s,
            # Host-config compatibility aliases. They remain on RPi and are
            # never serialized to STM32.
            "detect_settle_s": acquisition_s,
            "fast_settle_s": detection_s,
            "fast_duration_s": startup_s,
        }
        payload["dc_config_updated_at"] = int(time.time())
        tmp = path.with_name(f".{path.name}.tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(payload, f, ensure_ascii=False, sort_keys=True)
            f.write("\n")
        try:
            os.chmod(tmp, (previous_stat.st_mode & 0o777) if previous_stat is not None else 0o640)
        except Exception:
            pass
        if previous_stat is not None:
            try:
                os.chown(tmp, -1, previous_stat.st_gid)
            except Exception:
                pass
        os.replace(tmp, path)
    except Exception as exc:
        print(f"[DC] save default config failed: {exc}", flush=True)


def _led_pattern_value(value: Any, default: int = 0) -> int:
    try:
        pattern = int(str(value).strip())
