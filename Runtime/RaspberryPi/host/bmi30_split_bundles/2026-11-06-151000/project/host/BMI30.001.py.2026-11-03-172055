def _dc_wire_seconds(value: Any, default: float) -> float:
    val = _dc_float(value, default)
    try:
        return float(max(0, min(86_400_000, int(round(float(val) * 1000.0))))) / 1000.0
    except Exception:
        return _dc_wire_seconds(default, 0.0) if float(default) != 0.0 else 0.0


def _expected_dc_config(profile: str | None = None, mode: int | None = None, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
    source = dict(cfg or _load_default_dc_config())
    profile_name = str(profile or "").strip().lower().replace("-", "_")
    aliases = {
        "": "work",
        "operation": "work",
        "acquire": "acquisition",
        "predetect": "acquisition",
        "pre_detect": "acquisition",
        "detect": "detection",
        "start": "startup",
        "boot_fast": "startup",
        "disabled": "off",
    }
    profile_name = aliases.get(profile_name, profile_name)
    if not profile and mode is not None:
        try:
            profile_name = {0: "off", 1: "work", 2: "acquisition", 3: "startup"}.get(int(mode), "work")
        except Exception:
            profile_name = "work"
    if profile_name not in {"off", "work", "acquisition", "detection", "startup"}:
        profile_name = "work"
    key = {
        "off": None,
        "work": "work_settle_s",
        "acquisition": "acquisition_settle_s",
        "detection": "detection_settle_s",
        "startup": "startup_settle_s",
    }[profile_name]
    if profile_name == "startup":
        active_settle_s = DC_FASTEST_SETTLE_S
    else:
        active_settle_s = 0.0 if key is None else _dc_wire_seconds(source.get(key, 0.0), 0.0)
    settle_ms = max(0, min(86_400_000, int(round(active_settle_s * 1000.0))))
    return {
        "profile": profile_name,
        "state": profile_name,
        "settle_s": active_settle_s,
        "settle_ms": settle_ms,
        "enabled": bool(settle_ms != 0),
        "config_work_settle_s": float(source["work_settle_s"]),
        "config_acquisition_settle_s": float(source["acquisition_settle_s"]),
        "config_detection_settle_s": float(source["detection_settle_s"]),
        "config_startup_settle_s": DC_FASTEST_SETTLE_S,
        "config_lightning_timeout_s": float(source["lightning_timeout_s"]),
    }


def _dc_config_mismatches(readback: dict[str, Any], expected: dict[str, Any]) -> list[str]:
    if not isinstance(readback, dict) or not bool(readback.get("available", False)):
        return ["unavailable"]
    mismatches: list[str] = []
    try:
        if int(readback.get("version", 0) or 0) != 2:
            mismatches.append(f"version:{readback.get('version')}!=2")
    except Exception:
        mismatches.append("version")
    try:
        actual_ms = int(readback.get("settle_ms", -1))
        want_ms = int(expected.get("settle_ms", -2))
        if actual_ms != want_ms:
            mismatches.append(f"settle_ms:{actual_ms}!={want_ms}")
    except Exception:
        mismatches.append("settle_ms")
    try:
        if bool(readback.get("enabled", False)) != bool(expected.get("enabled", False)):
            mismatches.append(f"enabled:{int(bool(readback.get('enabled')))}!={int(bool(expected.get('enabled')))}")
    except Exception:
        mismatches.append("enabled")
    if not bool(readback.get("protocol_consistent", False)):
        mismatches.append("enabled_vs_settle_ms")
    return mismatches


