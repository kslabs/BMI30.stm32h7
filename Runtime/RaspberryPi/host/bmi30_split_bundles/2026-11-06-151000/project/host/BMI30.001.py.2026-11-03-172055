def start_http_server() -> ThreadingHTTPServer:
    server = ThreadingHTTPServer((API_HOST, API_PORT), ServiceHandler)
    th = threading.Thread(target=server.serve_forever, daemon=True)
    th.start()
    print(f"[BMI30.001] API listening on http://{API_HOST}:{API_PORT}", flush=True)
    return server


def main() -> int:
    os.environ["BMI30_SERVICE_MODE"] = "1"
    os.chdir(str(REPO_DIR))
    engine = _load_engine_module(ENGINE_FILE)
    if getattr(engine, "PG_IMPORT_ERR", None):
        print(f"[BMI30.001] engine runtime import failed: {engine.PG_IMPORT_ERR}", flush=True)
        return 2
    scope = engine.ScopeWindow()
    _start_qt_call_pump(engine.QtCore)
    _install_detector_flash_hooks(scope)
    _apply_default_avg_n(scope)
    _apply_default_detector_settings(scope)
    try:
        led_patterns = _load_group_led_patterns()
        if hasattr(scope, "_set_group_led_patterns"):
            scope._set_group_led_patterns(led_patterns)
        else:
            scope._group_led_patterns = led_patterns
    except Exception as exc:
        print(f"[BMI30.001] LED pattern map load failed: {exc}", flush=True)
    try:
        orig_num_clicked = scope._num_clicked
        dc_state_lock = threading.RLock()
        try:
            scope._host_dc_state_lock = dc_state_lock
            scope._host_dc_prefire_deadline_t = 0.0
        except Exception:
            pass

        def _schedule_mode5_work_dc(reason: str = "", attempt: int = 0) -> None:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected != 5:
                return
            recovery_fast = bool(
                getattr(scope, "_recovery_outputs_inhibited", False)
                and getattr(scope, "_auto_reset_just_occurred", False)
            )
            profile_name = "startup" if recovery_fast else "work"
            with dc_state_lock:
                # The explicit lightning callback owns restoration during its startup window.
                if time.time() < float(getattr(scope, "_host_dc_startup_until", 0.0) or 0.0):
                    return
                applied = _apply_default_dc_config(
                    scope,
                    reason=f"{reason}:{profile_name}:try{attempt}",
                    profile=profile_name,
                )
                if applied:
                    try:
                        scope._host_dc_desired_profile = "work"
                        if recovery_fast:
                            scope._host_dc_startup_until = time.time() + DC_FASTEST_SETTLE_S
                            scope._host_dc_startup_restore_profile = "work"
                        else:
                            scope._host_dc_startup_until = 0.0
                            scope._host_dc_startup_restore_profile = ""
                    except Exception:
                        pass
                    return
            if attempt < 20:
                try:
                    _call_later_s(0.3, lambda: _schedule_mode5_work_dc(reason, attempt + 1))
                except Exception:
                    pass

        def _schedule_default_dc_apply(reason: str = "", attempt: int = 0) -> None:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected == 5:
                return
            if selected >= 6:
                if bool(getattr(scope, "_recovery_mode6_fast_pending", False)):
                    # Первый полный цикл уже восстановленного режима 6
                    # остаётся на максимальной скорости DC.
                    return
                try:
                    stream_mode = int(getattr(scope, "stream_mode", 0) or 0)
                except Exception:
                    stream_mode = 0
                if stream_mode != 2:
                    if attempt < 12:
                        try:
                            _call_later_s(0.3, lambda: _schedule_default_dc_apply(reason, attempt + 1))
                        except Exception:
                            pass
                    return
                profile_name = "work"
            elif selected > 0:
                profile_name = "work"
            else:
                return
            with dc_state_lock:
                # The explicit lightning callback owns restoration during its startup window.
                if time.time() < float(getattr(scope, "_host_dc_startup_until", 0.0) or 0.0):
                    return
                # A delayed mode/default callback must not overwrite an active
                # detector Acquisition or Detection lease with Work.
                desired = str(getattr(scope, "_host_dc_desired_profile", "") or "").strip().lower()
                if selected >= 6 and desired in {"acquisition", "detection", "detect"}:
                    return
                if _apply_default_dc_config(scope, reason=f"{reason}:try{attempt}", profile=profile_name):
                    return
            if attempt < 12:
                try:
                    _call_later_s(0.3, lambda: _schedule_default_dc_apply(reason, attempt + 1))
                except Exception:
                    pass

        def _call_later_s(delay_s: float, fn: Any) -> None:
            try:
                _call_qt_later_s(delay_s, fn)
            except Exception:
                _queue_qt_call(fn)

        def _apply_fault_fast_dc(reason: str = "") -> bool:
            with dc_state_lock:
                try:
                    scope._host_dc_desired_profile = "work"
                    scope._host_dc_startup_until = time.time() + DC_FASTEST_SETTLE_S
                    scope._host_dc_startup_restore_profile = "work"
                except Exception:
                    pass
                return _apply_default_dc_config(
                    scope,
                    reason=f"{reason}:fault_fast",
                    profile="startup",
                )

        def _restore_work_dc_after_recovery(reason: str = "") -> bool:
            with dc_state_lock:
                try:
                    scope._host_dc_desired_profile = "work"
                    scope._host_dc_startup_until = 0.0
                    scope._host_dc_startup_restore_profile = ""
                except Exception:
                    pass
                return _apply_default_dc_config(
                    scope,
                    reason=f"{reason}:restore_work",
                    profile="work",
                )

        scope._host_apply_fault_fast_dc = _apply_fault_fast_dc
        scope._host_restore_work_dc_after_recovery = _restore_work_dc_after_recovery

        def _dc_verify_profile() -> str:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected == 5:
                return "work"
            if selected >= 6:
                profile = str(getattr(scope, "_host_dc_desired_profile", "") or "").strip().lower()
                if profile in {"acquisition", "detection", "detect"}:
                    return "detection" if profile == "detect" else profile
                return "work"
            if selected > 0:
                return "work"
            return ""

        def _set_dc_verify_status(ok: bool, profile: str, reason: str, mismatches: list[str] | None = None) -> None:
            try:
                scope._host_dc_verify_last_t = time.time()
                scope._host_dc_verify_last_ok = bool(ok)
                scope._host_dc_verify_last_profile = str(profile or "")
                scope._host_dc_verify_last_reason = str(reason or "")
                scope._host_dc_verify_last_mismatches = list(mismatches or [])
            except Exception:
                pass

        def _periodic_dc_verify() -> None:
            interval_s = _dc_verify_interval_s()
            try:
                try:
                    scope._host_dc_verify_enabled = True
                except Exception:
                    pass
                profile = _dc_verify_profile()
                if not profile:
                    _set_dc_verify_status(True, "", "idle")
                    return
                try:
                    if time.time() < float(getattr(scope, "_host_dc_startup_until", 0.0) or 0.0):
                        _set_dc_verify_status(True, profile, "startup_window")
                        return
                except Exception:
                    pass
                stream = getattr(scope, "stream", None)
                if stream is None or not hasattr(stream, "get_dc_config"):
                    _set_dc_verify_status(False, profile, "no_stream")
                    return
                readback = _dc_config_from_device(stream.get_dc_config())
                expected = _expected_dc_config(profile=profile)
                mismatches = _dc_config_mismatches(readback, expected)
                if not mismatches:
                    _set_dc_verify_status(True, profile, "ok")
                    return
                if mismatches == ["unavailable"]:
                    _set_dc_verify_status(False, profile, "readback_unavailable", mismatches)
                    print(
                        f"[DC] verify unavailable profile={profile}; skip reapply",
                        flush=True,
                    )
                    return
                _set_dc_verify_status(False, profile, "mismatch", mismatches)
                print(
                    f"[DC] verify mismatch profile={profile} mismatches={','.join(mismatches)}; "
                    "read-only check, SET_DC_SPEED not repeated",
                    flush=True,
                )
            except Exception as exc:
                _set_dc_verify_status(False, "", f"error:{exc}")
                print(f"[DC] verify failed: {exc}", flush=True)
            finally:
                try:
                    _call_later_s(interval_s, _periodic_dc_verify)
                except Exception:
                    pass

        def _num_clicked_with_dc_restore(idx: int, *args: Any, **kwargs: Any):
            result = orig_num_clicked(idx, *args, **kwargs)
            try:
                idx_i = int(idx)
                if idx_i == 5:
                    _call_later_s(0.05, lambda: _schedule_mode5_work_dc("mode_5_work", 0))
                elif idx_i > 0:
                    _call_later_s(0.05, lambda: _schedule_default_dc_apply(f"mode_{int(idx)}", 0))
            except Exception:
                pass
            return result

        scope._num_clicked = _num_clicked_with_dc_restore
        try:
            orig_set_det_gpio = scope._set_det_gpio
            # One cancelable timer is shared by all pre-fire renewals. Sequence-only
            # invalidation would leave every superseded threading.Timer sleeping.
            dc_restore_debounce = _SinglePendingQtCall()
            try:
                scope._host_dc_restore_debounce = dc_restore_debounce
            except Exception:
                pass

            def _det_dc_cancel_pending(clear_deadline: bool = True) -> int:
                with dc_state_lock:
                    try:
                        dc_restore_debounce.cancel()
                    except Exception:
                        pass
                    try:
                        seq = int(getattr(scope, "_host_dc_pending_seq", 0) or 0) + 1
                    except Exception:
                        seq = 1
                    try:
                        scope._host_dc_pending_seq = seq
                        scope._host_dc_pending_profile = ""
                        if bool(clear_deadline):
                            scope._host_dc_prefire_deadline_t = 0.0
                    except Exception:
                        pass
                    return seq

            def _det_dc_selected_active() -> bool:
                try:
                    # Work/Acquisition/Detection are RPi detector states and
                    # must not overwrite the explicit 1 s lightning speed in
                    # ordinary acquisition/display modes.
                    return int(scope.num_group.checkedId()) >= 6
                except Exception:
                    return False

            def _det_dc_startup_active() -> bool:
                try:
                    return time.time() < float(getattr(scope, "_host_dc_startup_until", 0.0) or 0.0)
                except Exception:
                    return False

            def _det_dc_dynamic_profiles_enabled() -> bool:
                try:
                    return str(os.getenv("BMI30_DC_DYNAMIC_PROFILES", "1")).lower() not in ("0", "false", "no", "off")
                except Exception:
                    return True

            def _det_dc_set_desired(profile_name: str) -> None:
                with dc_state_lock:
                    try:
                        scope._host_dc_desired_profile = str(profile_name or "").strip().lower()
                    except Exception:
                        pass

            def _det_dc_apply_profile(profile_name: str, reason: str) -> bool:
                with dc_state_lock:
                    profile_name = str(profile_name or "").strip().lower()
                    if not profile_name:
                        return False
                    if not _det_dc_selected_active():
                        return False
                    last_profile = str(getattr(scope, "_host_dc_profile", "") or "")
                    if profile_name == last_profile:
                        return False
                    if _apply_default_dc_config(scope, reason=reason, profile=profile_name):
                        try:
                            scope._host_dc_profile = profile_name
                            scope._host_dc_profile_t = time.time()
                        except Exception:
                            pass
                        return True
                    return False

            def _det_dc_restore_delay(env_name: str, default: float) -> float:
                try:
                    delay_s = float(os.getenv(env_name, str(default)))
                except Exception:
                    delay_s = float(default)
                try:
                    if not np.isfinite(delay_s):
                        delay_s = float(default)
                except Exception:
                    delay_s = float(default)
                return max(0.05, min(30.0, float(delay_s)))

            def _det_dc_apply_pending_work(seq: int, reason: str) -> None:
                with dc_state_lock:
                    if not _det_dc_selected_active():
                        return
                    if _det_dc_startup_active():
                        return
                    try:
                        if int(seq) != int(getattr(scope, "_host_dc_pending_seq", 0) or 0):
                            return
                        if str(getattr(scope, "_host_dc_pending_profile", "") or "") != "work":
                            return
                    except Exception:
                        return
                    try:
                        deadline_t = float(getattr(scope, "_host_dc_prefire_deadline_t", 0.0) or 0.0)
                    except Exception:
                        deadline_t = 0.0
                    remaining_s = deadline_t - time.monotonic()
                    if remaining_s > 0.01:
                        _det_dc_schedule_work_restore(reason, remaining_s, desired_now=False)
                        return
                    try:
                        scope._host_dc_pending_profile = ""
                        scope._host_dc_prefire_deadline_t = 0.0
                    except Exception:
                        pass
                    # Detection owns the profile until its outputs are released.
                    if str(getattr(scope, "_host_dc_desired_profile", "") or "") == "detection":
                        return
                    _det_dc_set_desired("work")
                    _det_dc_apply_profile("work", reason)

            def _det_dc_schedule_work_restore(reason: str, delay_s: float, desired_now: bool = False) -> None:
                with dc_state_lock:
                    if desired_now:
                        _det_dc_set_desired("work")
                    seq = _det_dc_cancel_pending(clear_deadline=False)
                    delay_s = max(0.05, min(30.0, float(delay_s)))
                    try:
                        scope._host_dc_pending_profile = "work"
                        scope._host_dc_prefire_deadline_t = time.monotonic() + delay_s
                        dc_restore_debounce.schedule(
                            delay_s,
                            lambda seq=seq: _det_dc_apply_pending_work(seq, reason),
                        )
                    except Exception:
                        # Timer creation failure must not recurse through another
                        # schedule attempt. Fall back to a deterministic state.
                        try:
                            scope._host_dc_pending_profile = ""
                            scope._host_dc_prefire_deadline_t = 0.0
                        except Exception:
                            pass
                        if str(getattr(scope, "_host_dc_desired_profile", "") or "") != "detection":
                            _det_dc_set_desired("work")
                            _det_dc_apply_profile("work", f"{reason}:timer_failed")

            def _det_dc_pre_fire(channel: Any, count: Any = 0, confirm_count: Any = 0) -> None:
                with dc_state_lock:
                    if not _det_dc_dynamic_profiles_enabled():
                        return
                    if not _det_dc_selected_active() or _det_dc_startup_active():
                        return
                    try:
                        count_i = int(count)
                    except Exception:
                        count_i = 0
                    try:
                        confirm_i = max(1, int(confirm_count))
                    except Exception:
                        confirm_i = 1
                    if count_i <= 0 or count_i >= confirm_i:
                        return
                    # A short confirmation miss must not bounce the STM32 DC state
                    # between Work and Acquisition. Every candidate, including one
                    # on the other channel during Detection, renews the quiet lease.
                    delay_s = _det_dc_restore_delay("BMI30_DC_PREFIRE_RESTORE_DELAY_S", 10.0)
                    desired = str(getattr(scope, "_host_dc_desired_profile", "") or "")
                    if desired != "detection":
                        _det_dc_set_desired("acquisition")
                        _det_dc_apply_profile("acquisition", f"pre_fire:ch{channel}:{count_i}/{confirm_i}")
                    _det_dc_schedule_work_restore("pre_fire:restore_work", delay_s, desired_now=False)

            def _det_dc_detection_fire(fired0: Any = False, fired1: Any = False, reason: str = "det_fire") -> None:
                with dc_state_lock:
                    if not _det_dc_dynamic_profiles_enabled():
                        return
                    if not _det_dc_selected_active() or _det_dc_startup_active():
                        return
                    if not (bool(fired0) or bool(fired1)):
                        return
                    try:
                        if str(getattr(scope, "_host_dc_desired_profile", "") or "") == "detection":
                            return
                    except Exception:
                        pass
                    _det_dc_cancel_pending(clear_deadline=True)
                    _det_dc_set_desired("detection")
                    _det_dc_apply_profile("detection", reason)

            def _arg_value(args: tuple[Any, ...], kwargs: dict[str, Any], index: int, name: str, default: Any = None) -> Any:
                if name in kwargs:
                    return kwargs.get(name)
                if len(args) > index:
                    return args[index]
                return default

            orig_pre_fire = getattr(scope, "_mark_web_pre_fire", None)
            if callable(orig_pre_fire):
                def _mark_web_pre_fire_with_dc(*args: Any, **kwargs: Any) -> Any:
                    result = orig_pre_fire(*args, **kwargs)
                    _det_dc_pre_fire(
                        _arg_value(args, kwargs, 0, "channel", 0),
                        _arg_value(args, kwargs, 1, "count", 0),
                        _arg_value(args, kwargs, 2, "confirm_count", 0),
                    )
                    return result

                scope._mark_web_pre_fire = _mark_web_pre_fire_with_dc

            orig_detection_fire = getattr(scope, "_mark_web_detection_fire", None)
            if callable(orig_detection_fire):
                def _mark_web_detection_fire_with_dc(*args: Any, **kwargs: Any) -> Any:
                    result = orig_detection_fire(*args, **kwargs)
                    fired0 = _arg_value(args, kwargs, 0, "fired0", False)
                    fired1 = _arg_value(args, kwargs, 1, "fired1", False)
                    _det_dc_detection_fire(fired0, fired1, "det_fire:confirmed")
                    return result

                scope._mark_web_detection_fire = _mark_web_detection_fire_with_dc

            def _set_det_gpio_with_dc_profile(a_on: bool, b_on: bool, *args: Any, **kwargs: Any):
                result = orig_set_det_gpio(a_on, b_on, *args, **kwargs)
                with dc_state_lock:
                    if not _det_dc_dynamic_profiles_enabled():
                        return result
                    if _det_dc_selected_active():
                        active = bool(a_on) or bool(b_on)
                        if active:
                            _det_dc_detection_fire(a_on, b_on, "det_output:detection")
                            return result
                        if _det_dc_startup_active():
                            return result
                        desired = str(getattr(scope, "_host_dc_desired_profile", "") or "")
                        if desired == "acquisition":
                            return result
                        try:
                            deadline_t = float(getattr(scope, "_host_dc_prefire_deadline_t", 0.0) or 0.0)
                        except Exception:
                            deadline_t = 0.0
                        remaining_s = deadline_t - time.monotonic()
                        if desired == "detection" and remaining_s > 0.01:
                            _det_dc_set_desired("acquisition")
                            _det_dc_apply_profile("acquisition", "det_output:acquisition_lease")
                            _det_dc_schedule_work_restore(
                                "pre_fire:restore_work",
                                remaining_s,
                                desired_now=False,
                            )
                            return result
                        _det_dc_cancel_pending(clear_deadline=True)
                        _det_dc_set_desired("work")
                        _det_dc_apply_profile("work", "det_output:work")
                return result

            scope._set_det_gpio = _set_det_gpio_with_dc_profile
        except Exception as exc:
            print(f"[DC] detector profile hook failed: {exc}", flush=True)
        _call_later_s(0.7, lambda: _schedule_mode5_work_dc("initial_mode_5", 0))
        _call_later_s(0.7, lambda: _schedule_default_dc_apply("initial_mode_6plus", 0))
        _call_later_s(2.5, lambda: _schedule_default_dc_apply("initial_mode_settle", 0))
        _call_later_s(_dc_verify_interval_s(), _periodic_dc_verify)
    except Exception as exc:
        print(f"[DC] mode restore hook failed: {exc}", flush=True)
    try:
        scope.win.hide()
        scope.win.setWindowTitle(f"BMI30 core service {SERVICE_VERSION}")
    except Exception:
        pass
    global API
    API = ScopeApi(scope, engine.QtCore)
    import signal
    previous_term = signal.getsignal(signal.SIGTERM)
    def stop_relay_on_term(signum, frame):
        API.relay_service.close()
        if callable(previous_term):
            previous_term(signum, frame)
        elif previous_term == signal.SIG_DFL:
            raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop_relay_on_term)
    server = start_http_server()
    try:
        _call_qt_later_s(0.02, scope._run_deferred_autostart)
    except Exception:
        scope._run_deferred_autostart()
    app = engine.QtWidgets.QApplication.instance()
    try:
        if hasattr(app, "exec_"):
            app.exec_()
        else:
            app.exec()
    finally:
        API.relay_service.close()
        try:
            server.shutdown()
        except Exception:
            pass
        try:
            scope._rt_detector_process_stop()
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
