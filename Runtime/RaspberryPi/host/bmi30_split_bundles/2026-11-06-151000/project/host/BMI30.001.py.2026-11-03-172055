    except Exception:
        return ""


def _int_env(name: str, default: int) -> int:
    try:
        return int(os.getenv(name, str(default)))
    except Exception:
        return int(default)


def _api_bool(value: Any, default: bool = False) -> bool:
    if value is None:
        return bool(default)
    if isinstance(value, bool):
        return bool(value)
    if isinstance(value, (int, float)):
        return bool(value)
    try:
        text = str(value).strip().lower()
    except Exception:
        return bool(default)
    if text in {"1", "true", "yes", "on", "y", "t"}:
        return True
    if text in {"0", "false", "no", "off", "n", "f"}:
        return False
    return bool(default)


def _dc_seconds_from_ms(raw: dict[str, Any], key: str, default: float = 0.0) -> float:
    try:
        return max(0.0, float(int(raw.get(key, int(default * 1000.0)) or 0)) / 1000.0)
    except Exception:
        return float(default)


def _dc_config_from_device(raw: Any) -> dict[str, Any]:
    if not isinstance(raw, dict):
        return {"available": False, "source": "device", "raw": raw}
    if "settle_ms" not in raw:
        return {"available": False, "source": "device", "raw": raw}
    try:
        settle_ms = max(0, min(86_400_000, int(raw.get("settle_ms", 0) or 0)))
    except Exception:
        return {"available": False, "source": "device", "raw": raw}
    enabled = bool(raw.get("enabled", False))
    return {
        "available": True,
        "source": "device",
        "version": int(raw.get("version", 0) or 0),
        "enabled": enabled,
        "flags": int(raw.get("flags", 0) or 0),
        "settle_ms": settle_ms,
        "settle_s": float(settle_ms) / 1000.0,
        "set_at_ms": int(raw.get("set_at_ms", 0) or 0),
        "adapt_updates": int(raw.get("adapt_updates", 0) or 0),
        "dirty": bool(raw.get("dirty", False)),
        "protocol_consistent": enabled == bool(settle_ms != 0),
        "raw": raw,
    }


