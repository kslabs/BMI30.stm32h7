def _sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def _player_pulse_command(binary: str, *args: str) -> list[str]:
    audio_user = os.getenv("BMI30_BLUETOOTH_AUDIO_USER", "techaid").strip() or "techaid"
    try:
        account = pwd.getpwnam(audio_user)
        uid = int(account.pw_uid)
        audio_home = account.pw_dir
    except Exception:
        uid = int(getattr(os, "getuid", lambda: 1000)())
        audio_home = f"/home/{audio_user}"
    runtime_dir = f"/run/user/{uid}"
    command = [
        "env",
        f"XDG_RUNTIME_DIR={runtime_dir}",
        f"PULSE_SERVER=unix:{runtime_dir}/pulse/native",
    ]
    if int(getattr(os, "geteuid", lambda: 1)()) == 0:
        pulse_cookie = os.getenv(
            "BMI30_BLUETOOTH_AUDIO_COOKIE",
            os.path.join(audio_home, ".config", "pulse", "cookie"),
        )
        command.append(f"PULSE_COOKIE={pulse_cookie}")
    command.extend([binary, *args])
    return command


def _player_pactl(*args: str, timeout: float = 5.0) -> tuple[bool, str]:
    try:
        proc = subprocess.run(
            _player_pulse_command("pactl", *args),
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except Exception as exc:
        return False, str(exc)
    output = "\n".join(part.strip() for part in (proc.stdout, proc.stderr) if part and part.strip())
    return proc.returncode == 0, output


