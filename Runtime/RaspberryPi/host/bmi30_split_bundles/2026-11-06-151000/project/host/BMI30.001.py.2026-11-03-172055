def _player_server_voice_start(api: "ScopeApi") -> dict[str, Any]:
    global _PLAYER_SERVER_VOICE_PROCESS, _PLAYER_SERVER_VOICE_HANDLE
    _player_server_voice_stop(api, recording_name="", save=False)
    heartbeat_paused = _player_set_voice_playback_inhibit(
        True,
        reason="recording",
        duration_s=3600.0,
    )
    stopped_heartbeats = _player_stop_active_heartbeat() if heartbeat_paused else 0
    if stopped_heartbeats:
        time.sleep(0.08)
    source = _player_server_voice_source()
    if not source:
        _player_set_voice_playback_inhibit(False, expected_reason="recording")
        with _PLAYER_SERVER_VOICE_LOCK:
            _PLAYER_SERVER_VOICE_STATE.update({
                "enabled": True,
                "running": False,
                "source": "",
                "sample_rate_hz": 0,
                "heartbeat_paused": False,
                "message": "Raspberry microphone source is unavailable.",
                "error": "Connect a USB microphone or select the HFP/HSP headset microphone profile.",
            })
        return _player_server_voice_snapshot()
    sample_rate_hz = _player_server_voice_sample_rate(source)
    record_dir = os.path.abspath(_player_record_dir_for_upload(api))
    os.makedirs(record_dir, exist_ok=True)
    raw_path = os.path.join(
        record_dir,
        f".bmi30-player-voice-{os.getpid()}-{time.time_ns()}.s16le",
    )
    handle: Any = None
    process: subprocess.Popen[bytes] | None = None
    started_at = time.time()
    try:
        handle = open(raw_path, "wb", buffering=0)
        process = subprocess.Popen(
            _player_server_voice_capture_command(source, sample_rate_hz),
            stdin=subprocess.DEVNULL,
            stdout=handle,
            stderr=subprocess.PIPE,
        )
        time.sleep(0.12)
        if process.poll() is not None:
            error = ""
            try:
                error = (process.stderr.read(1000) if process.stderr else b"").decode("utf-8", errors="replace").strip()
            except Exception:
                error = ""
            raise RuntimeError(error or f"parec exited with code {process.returncode}")
        source_kind = "USB microphone" if source.lower().startswith("alsa_input.") else "Bluetooth microphone"
        with _PLAYER_SERVER_VOICE_LOCK:
            _PLAYER_SERVER_VOICE_PROCESS = process
            _PLAYER_SERVER_VOICE_HANDLE = handle
            _PLAYER_SERVER_VOICE_STATE.update({
                "enabled": True,
                "running": True,
                "source": source,
                "sample_rate_hz": sample_rate_hz,
                "raw_path": raw_path,
                "started_at_server_s": started_at,
                "bytes": 0,
                "heartbeat_paused": bool(heartbeat_paused),
                "message": (
                    f"Raspberry {source_kind} recording is active at {sample_rate_hz} Hz; Bluetooth playback is paused."
                ),
                "error": "",
            })
        return _player_server_voice_snapshot()
    except Exception as exc:
        _player_set_voice_playback_inhibit(False, expected_reason="recording")
        if process is not None and process.poll() is None:
            try:
                process.terminate()
            except Exception:
                pass
        if handle is not None:
            try:
                handle.close()
            except Exception:
                pass
        try:
            if os.path.exists(raw_path):
                os.unlink(raw_path)
        except Exception:
            pass
        with _PLAYER_SERVER_VOICE_LOCK:
            _PLAYER_SERVER_VOICE_PROCESS = None
            _PLAYER_SERVER_VOICE_HANDLE = None
            _PLAYER_SERVER_VOICE_STATE.update({
                "enabled": True,
                "running": False,
                "source": source,
                "sample_rate_hz": sample_rate_hz,
                "raw_path": "",
                "bytes": 0,
                "heartbeat_paused": False,
                "message": "Unable to start Raspberry voice recording.",
                "error": str(exc)[:500],
            })
        return _player_server_voice_snapshot()


def _player_server_voice_utterances(
    pcm: np.ndarray,
    sample_rate: int,
    voice_start_server_s: float,
    recording_path: str,
) -> list[dict[str, Any]]:
    if pcm.size < max(1, sample_rate // 10):
        return []
    block_samples = max(1, int(round(sample_rate * 0.04)))
    noise_floor = 0.00003
    active = False
    loud_blocks = 0
    quiet_blocks = 0
    start_s = 0.0
    last_loud_s = 0.0
    ranges: list[tuple[float, float]] = []
    normalized = pcm.astype(np.float64, copy=False) / 32768.0
    for offset in range(0, normalized.size, block_samples):
        block = normalized[offset:offset + block_samples]
        if block.size < block_samples // 2:
            break
        rms = float(np.sqrt(np.mean(block * block)))
        now_s = float(offset) / float(sample_rate)
        if not active:
            noise_floor = max(0.00001, min(0.02, noise_floor * 0.985 + rms * 0.015))
        threshold = max(0.00035, noise_floor * 4.0)
        if rms >= threshold:
            loud_blocks += 1
            quiet_blocks = 0
            last_loud_s = now_s + (float(block.size) / float(sample_rate))
            if not active and loud_blocks >= 2:
                active = True
                start_s = max(0.0, now_s - 0.12)
        else:
            loud_blocks = 0
            if active:
                quiet_blocks += 1
                if quiet_blocks >= 9:
                    ranges.append((start_s, max(start_s, last_loud_s + 0.20)))
                    active = False
                    quiet_blocks = 0
    if active:
        ranges.append((start_s, max(start_s, last_loud_s + 0.20)))

    host_t = np.array([], dtype=np.float64)
    try:
        with np.load(recording_path, allow_pickle=False) as data:
            if "host_t" in data.files:
                host_t = np.asarray(data["host_t"], dtype=np.float64).reshape(-1)
    except Exception:
        host_t = np.array([], dtype=np.float64)
    result: list[dict[str, Any]] = []
    for index, (audio_start, audio_end) in enumerate(ranges[:200]):
        server_start = voice_start_server_s + audio_start
        server_end = voice_start_server_s + audio_end
        packet_start = -1
        packet_end = -1
        finite = np.isfinite(host_t) & (host_t > 0.0) if host_t.size else np.array([], dtype=bool)
        values = host_t[finite] if host_t.size else np.array([], dtype=np.float64)
        indices = np.flatnonzero(finite) if host_t.size else np.array([], dtype=np.int64)
        if values.size:
            start_pos = max(0, min(values.size - 1, int(np.searchsorted(values, server_start, side="left"))))
            end_pos = max(start_pos, min(values.size - 1, int(np.searchsorted(values, server_end, side="right") - 1)))
            packet_start = int(indices[start_pos])
            packet_end = int(indices[end_pos])
        result.append({
            "utterance_index": index,
            "audio_start_s": audio_start,
            "audio_end_s": audio_end,
            "server_start_s": server_start,
            "server_end_s": server_end,
            "packet_start": packet_start,
            "packet_end": packet_end,
            "source": "raspberry_energy_vad",
        })
    return result


def _player_voice_atomic_json(path: str, payload: dict[str, Any]) -> None:
    tmp_path = f"{path}.{os.getpid()}.{threading.get_ident()}.tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, sort_keys=True, indent=2)
            handle.write("\n")
        os.replace(tmp_path, path)
    finally:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass


def _player_voice_packet_range(
    recording_path: str,
    server_start_s: float,
    server_end_s: float,
) -> tuple[int, int]:
    try:
        with np.load(recording_path, allow_pickle=False) as data:
            if "host_t" not in data.files:
                return -1, -1
            host_t = np.asarray(data["host_t"], dtype=np.float64).reshape(-1)
    except Exception:
        return -1, -1
    finite = np.isfinite(host_t) & (host_t > 0.0)
    values = host_t[finite]
    indices = np.flatnonzero(finite)
    if not values.size:
        return -1, -1
    start_pos = max(0, min(values.size - 1, int(np.searchsorted(values, server_start_s, side="left"))))
    end_pos = max(
        start_pos,
        min(values.size - 1, int(np.searchsorted(values, server_end_s, side="right") - 1)),
    )
    return int(indices[start_pos]), int(indices[end_pos])


def _player_voice_command_type(text: str) -> tuple[str, str]:
    normalized = " ".join(re.sub(r"[^0-9a-zа-яё]+", " ", str(text or "").lower()).split())
    if not normalized:
        return "", ""
    has_tag = "метк" in normalized
    has_basket = "корзин" in normalized
    if has_tag and any(token in normalized for token in ("нет", "отсутств", "не обнаруж", "не нашли")):
        return "tag_absent", "Метки нет"
    if has_tag and any(token in normalized for token in ("есть", "обнаруж", "нашли", "присутств", "имеется", "прошла")):
        return "tag_present", "Метка есть"
    if has_basket and any(token in normalized for token in ("начала", "начало", "поехала", "пошла", "въехала", "заехала", "старт")):
        return "basket_passage_start", "Начало провоза корзины"
    if has_basket and any(token in normalized for token in ("прошла", "проехала", "заверш", "конец", "выехала", "останов")):
        return "basket_passage_complete", "Корзина прошла"
    if has_basket and any(token in normalized for token in ("проезд", "провоз", "проходит", "едет")):
        return "basket_passage", "Провоз корзины"
    return "", ""


def _player_voice_transcription_payload(
    whisper_result: dict[str, Any],
    recording_path: str,
    manifest: dict[str, Any],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], str]:
    voice_start = float(manifest.get("voice_start_server_estimate_s", 0.0) or 0.0)
    raw_segments = whisper_result.get("transcription", [])
    if not isinstance(raw_segments, list):
        raw_segments = []
    segments: list[dict[str, Any]] = []
    events: list[dict[str, Any]] = []
    full_text_parts: list[str] = []
    for raw_index, raw_segment in enumerate(raw_segments[:1000]):
        if not isinstance(raw_segment, dict):
            continue
        text_value = " ".join(str(raw_segment.get("text", "") or "").split())
        if not text_value:
            continue
        offsets = raw_segment.get("offsets", {})
        offsets = offsets if isinstance(offsets, dict) else {}
        audio_start = max(0.0, float(offsets.get("from", 0.0) or 0.0) / 1000.0)
        audio_end = max(audio_start, float(offsets.get("to", 0.0) or 0.0) / 1000.0)
        server_start = voice_start + audio_start
        server_end = voice_start + audio_end
        packet_start, packet_end = _player_voice_packet_range(recording_path, server_start, server_end)
        probabilities: list[float] = []
        raw_tokens = raw_segment.get("tokens", [])
        for token in raw_tokens if isinstance(raw_tokens, list) else []:
            if not isinstance(token, dict):
                continue
            token_text = str(token.get("text", "") or "")
            if token_text.startswith("[_") and token_text.endswith("_]"):
                continue
            try:
                probability = float(token.get("p", 0.0) or 0.0)
            except Exception:
                continue
            if np.isfinite(probability):
                probabilities.append(max(0.0, min(1.0, probability)))
        confidence = float(sum(probabilities) / len(probabilities)) if probabilities else 0.0
        segment = {
            "segment_index": len(segments),
            "source_segment_index": raw_index,
            "text": text_value,
            "audio_start_s": audio_start,
            "audio_end_s": audio_end,
            "server_start_s": server_start,
            "server_end_s": server_end,
            "packet_start": packet_start,
            "packet_end": packet_end,
            "confidence": confidence,
        }
        segments.append(segment)
        full_text_parts.append(text_value)

        phrase_matches = list(re.finditer(r"[^.!?;]+(?:[.!?;]+|$)", text_value))
        text_length = max(1, len(text_value))
        duration = max(0.0, audio_end - audio_start)
        for phrase_match in phrase_matches:
            phrase = " ".join(phrase_match.group(0).strip().split())
            event_type, label = _player_voice_command_type(phrase)
            if not event_type:
                continue
            phrase_start = audio_start + duration * (float(phrase_match.start()) / float(text_length))
            phrase_end = audio_start + duration * (float(phrase_match.end()) / float(text_length))
            event_server_start = voice_start + phrase_start
            event_server_end = voice_start + phrase_end
            event_packet_start, event_packet_end = _player_voice_packet_range(
                recording_path,
                event_server_start,
                event_server_end,
            )
            events.append({
                "event_index": len(events),
                "event_type": event_type,
                "label": label,
                "phrase": phrase,
                "audio_start_s": phrase_start,
                "audio_end_s": phrase_end,
                "server_start_s": event_server_start,
                "server_end_s": event_server_end,
                "packet_start": event_packet_start,
                "packet_end": event_packet_end,
                "confidence": confidence,
                "source": "voice_transcript",
                "review_state": "unreviewed",
                "decision_role": "operator_annotation",
            })
    return segments, events, " ".join(full_text_parts).strip()


def _player_voice_transcription_update(manifest_path: str, updates: dict[str, Any]) -> dict[str, Any]:
    with _PLAYER_VOICE_STT_LOCK:
        with open(manifest_path, "r", encoding="utf-8") as handle:
            manifest = json.load(handle)
        if not isinstance(manifest, dict):
            raise ValueError("invalid voice manifest")
        transcription = manifest.get("transcription", {})
        transcription = dict(transcription) if isinstance(transcription, dict) else {}
        transcription.update(updates)
        manifest["transcription"] = transcription
        if "events" in updates:
            manifest["voice_events"] = list(updates.get("events", []) or [])
        _player_voice_atomic_json(manifest_path, manifest)
        return manifest


def _player_voice_transcription_worker(recording_path: str, manifest_path: str) -> None:
    job_key = os.path.abspath(recording_path)
    work_dir = ""
    try:
        with _PLAYER_VOICE_STT_SEMAPHORE:
            started = time.time()
            _player_voice_transcription_update(manifest_path, {
                "state": "running",
                "started_at": datetime.datetime.now().isoformat(timespec="seconds"),
                "error": "",
            })
            with open(manifest_path, "r", encoding="utf-8") as handle:
                manifest = json.load(handle)
            record_dir = os.path.dirname(os.path.abspath(recording_path))
            audio_name = os.path.basename(str(manifest.get("audio_file", "") or ""))
            audio_path = os.path.abspath(os.path.join(record_dir, audio_name))
            if not audio_name or os.path.dirname(audio_path) != record_dir or not os.path.exists(audio_path):
                raise RuntimeError("voice audio file not found")
            if not _PLAYER_VOICE_STT_BINARY.is_file():
                raise RuntimeError(f"speech recognizer not found: {_PLAYER_VOICE_STT_BINARY}")
            if not _PLAYER_VOICE_STT_MODEL.is_file():
                raise RuntimeError(f"speech model not found: {_PLAYER_VOICE_STT_MODEL}")
            work_dir = tempfile.mkdtemp(prefix="bmi30-player-stt-")
            wav_16k = os.path.join(work_dir, "voice-16k.wav")
            output_prefix = os.path.join(work_dir, "result")
            ffmpeg_binary = str(os.getenv("BMI30_PLAYER_STT_FFMPEG", "/usr/bin/ffmpeg") or "/usr/bin/ffmpeg")
            resample = subprocess.run(
                [
                    ffmpeg_binary, "-nostdin", "-hide_banner", "-loglevel", "error", "-y", "-i", audio_path,
                    "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", wav_16k,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=180.0,
                check=False,
            )
            if resample.returncode != 0:
                detail = resample.stderr.decode("utf-8", errors="replace").strip()
                raise RuntimeError(f"audio conversion failed: {detail[:300]}")
            duration = max(0.0, float(manifest.get("audio_duration_s", 0.0) or 0.0))
            timeout_s = max(90.0, min(3600.0, duration * 8.0 + 60.0))
            threads = max(1, min(4, int(os.getenv("BMI30_PLAYER_STT_THREADS", "3") or 3)))
            command = [
                "/usr/bin/nice", "-n", "8", str(_PLAYER_VOICE_STT_BINARY),
                "-m", str(_PLAYER_VOICE_STT_MODEL), "-f", wav_16k,
                "-l", _PLAYER_VOICE_STT_LANGUAGE, "-t", str(threads),
                "-ojf", "-of", output_prefix, "--prompt", _PLAYER_VOICE_STT_PROMPT,
            ]
            child_env = dict(os.environ)
            child_env["OMP_NUM_THREADS"] = str(threads)
            recognized = subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout_s,
                check=False,
                env=child_env,
            )
            if recognized.returncode != 0:
                detail = recognized.stderr.decode("utf-8", errors="replace").strip()
                raise RuntimeError(f"speech recognition failed: {detail[-500:]}")
            result_path = output_prefix + ".json"
            with open(result_path, "r", encoding="utf-8") as handle:
                whisper_result = json.load(handle)
            segments, events, full_text = _player_voice_transcription_payload(
                whisper_result if isinstance(whisper_result, dict) else {},
                recording_path,
                manifest,
            )
            result_info = whisper_result.get("result", {}) if isinstance(whisper_result, dict) else {}
            result_info = result_info if isinstance(result_info, dict) else {}
            _player_voice_transcription_update(manifest_path, {
                "state": "complete",
                "engine": "whisper.cpp",
                "model": _PLAYER_VOICE_STT_MODEL.name,
                "language": str(result_info.get("language", _PLAYER_VOICE_STT_LANGUAGE) or _PLAYER_VOICE_STT_LANGUAGE),
                "text": full_text,
                "segments": segments,
                "events": events,
                "event_count": len(events),
                "elapsed_s": max(0.0, time.time() - started),
                "completed_at": datetime.datetime.now().isoformat(timespec="seconds"),
                "error": "",
            })
            print(
                f"[PLAYER-STT] complete {os.path.basename(recording_path)}: "
                f"{len(segments)} segments, {len(events)} events",
                flush=True,
            )
    except Exception as exc:
        try:
            _player_voice_transcription_update(manifest_path, {
                "state": "error",
                "error": str(exc)[:1000],
                "completed_at": datetime.datetime.now().isoformat(timespec="seconds"),
            })
        except Exception:
            pass
        print(f"[PLAYER-STT] failed {os.path.basename(recording_path)}: {exc}", flush=True)
    finally:
        if work_dir:
            try:
                for item in os.listdir(work_dir):
                    item_path = os.path.join(work_dir, item)
                    if os.path.isfile(item_path):
                        os.unlink(item_path)
                os.rmdir(work_dir)
            except Exception:
                pass
        with _PLAYER_VOICE_STT_LOCK:
            _PLAYER_VOICE_STT_JOBS.pop(job_key, None)


def _player_voice_transcription_start_path(recording_path: str, *, force: bool = False) -> dict[str, Any]:
    recording_path = os.path.abspath(recording_path)
    record_dir = os.path.dirname(recording_path)
    stem = os.path.splitext(os.path.basename(recording_path))[0]
    manifest_path = os.path.abspath(os.path.join(record_dir, f"{stem}.voice.json"))
    if os.path.dirname(manifest_path) != record_dir or not os.path.exists(manifest_path):
        return {"ok": False, "started": False, "error": "voice manifest not found"}
    with _PLAYER_VOICE_STT_LOCK:
        active = _PLAYER_VOICE_STT_JOBS.get(recording_path)
        if active is not None and active.is_alive():
            return {
                "ok": True,
                "started": False,
                "state": "running",
                "message": "Speech recognition is already running.",
            }
        try:
            with open(manifest_path, "r", encoding="utf-8") as handle:
                manifest = json.load(handle)
            existing = manifest.get("transcription", {}) if isinstance(manifest, dict) else {}
            existing_state = str(existing.get("state", "") or "") if isinstance(existing, dict) else ""
            if existing_state == "complete" and not force:
                return {
                    "ok": True,
                    "started": False,
                    "state": "complete",
                    "message": "Speech recognition is already complete.",
                }
            transcription = dict(existing) if isinstance(existing, dict) else {}
            transcription.update({
                "state": "pending",
                "engine": "whisper.cpp",
                "model": _PLAYER_VOICE_STT_MODEL.name,
                "language": _PLAYER_VOICE_STT_LANGUAGE,
                "text": "" if force else str(transcription.get("text", "") or ""),
                "segments": [] if force else list(transcription.get("segments", []) or []),
                "events": [] if force else list(transcription.get("events", []) or []),
                "event_count": 0 if force else int(transcription.get("event_count", 0) or 0),
                "queued_at": datetime.datetime.now().isoformat(timespec="seconds"),
                "error": "",
            })
            manifest["transcription"] = transcription
            if force:
                manifest["voice_events"] = []
            _player_voice_atomic_json(manifest_path, manifest)
        except Exception as exc:
            return {"ok": False, "started": False, "error": str(exc)[:500]}
        thread = threading.Thread(
            target=_player_voice_transcription_worker,
            args=(recording_path, manifest_path),
            name=f"bmi30-player-stt-{stem[-16:]}",
            daemon=True,
        )
        _PLAYER_VOICE_STT_JOBS[recording_path] = thread
        thread.start()
    return {"ok": True, "started": True, "state": "pending", "message": "Speech recognition queued."}


def _player_voice_transcription_start(api: "ScopeApi", name: str, *, force: bool = False) -> dict[str, Any]:
    recording_path = _player_recording_path_for_download(api, name)
    if not recording_path or not os.path.exists(recording_path):
        return {"ok": False, "started": False, "error": "recording file not found"}
    return _player_voice_transcription_start_path(recording_path, force=force)


def _player_server_voice_finalize(
    raw_path: str,
    recording_path: str,
    *,
    voice_start_server_s: float,
    source: str,
    sample_rate_hz: int = 8000,
) -> dict[str, Any]:
    try:
        sample_rate = int(sample_rate_hz)
    except Exception:
        sample_rate = 8000
    if not 8000 <= sample_rate <= 48000:
        sample_rate = 8000
    record_dir = os.path.dirname(os.path.abspath(recording_path))
    stem = os.path.splitext(os.path.basename(recording_path))[0]
    target = os.path.abspath(os.path.join(record_dir, f"{stem}.voice.wav"))
    if os.path.dirname(target) != record_dir:
        raise ValueError("invalid server voice target")
    with open(raw_path, "rb") as handle:
        raw = handle.read()
    raw = raw[: len(raw) - (len(raw) % 2)]
    if not raw:
        raise RuntimeError("Raspberry microphone capture produced no PCM data.")
    raw_pcm = np.frombuffer(raw, dtype="<i2")
    raw_normalized = raw_pcm.astype(np.float64, copy=False) / 32768.0
    raw_rms = float(np.sqrt(np.mean(raw_normalized * raw_normalized))) if raw_normalized.size else 0.0
    raw_peak = float(np.max(np.abs(raw_normalized))) if raw_normalized.size else 0.0
    raw_rms_db = max(-100.0, 20.0 * np.log10(max(raw_rms, 0.00001)))
    raw_peak_db = max(-100.0, 20.0 * np.log10(max(raw_peak, 0.00001)))
    target_peak = float(10.0 ** (-2.0 / 20.0))
    max_gain = float(10.0 ** (24.0 / 20.0))
    gain = 1.0 if raw_peak <= 0.0 else max(1.0, min(max_gain, target_peak / raw_peak))
    amplified = np.clip(
        np.rint(raw_pcm.astype(np.float64) * gain),
        -32768.0,
        32767.0,
    ).astype("<i2")
    wav_payload = amplified.tobytes()
    wav_tmp = f"{target}.{os.getpid()}.tmp"
    try:
        with wave.open(wav_tmp, "wb") as wav_file:
            wav_file.setnchannels(1)
            wav_file.setsampwidth(2)
            wav_file.setframerate(sample_rate)
            wav_file.writeframes(wav_payload)
        os.replace(wav_tmp, target)
    finally:
        try:
            if os.path.exists(wav_tmp):
                os.unlink(wav_tmp)
        except Exception:
            pass
    pcm = amplified
    normalized = pcm.astype(np.float64, copy=False) / 32768.0
    rms = float(np.sqrt(np.mean(normalized * normalized))) if normalized.size else 0.0
    peak = float(np.max(np.abs(normalized))) if normalized.size else 0.0
    rms_db = max(-100.0, 20.0 * np.log10(max(rms, 0.00001)))
    peak_db = max(-100.0, 20.0 * np.log10(max(peak, 0.00001)))
    duration_s = float(pcm.size) / float(sample_rate)
    timing = _player_recording_timing(recording_path)
    record_started = float(timing.get("record_started_server_s", 0.0) or 0.0)
    utterances = _player_server_voice_utterances(pcm, sample_rate, voice_start_server_s, recording_path)
    manifest = {
        "schema": "bmi30-player-voice-v3-server-stt",
        "recording_file": os.path.basename(recording_path),
        "audio_file": os.path.basename(target),
        "mime_type": "audio/wav",
        "audio_bytes": int(os.path.getsize(target)),
        "audio_sha256": _sha256_file(target),
        "audio_duration_s": duration_s,
        "utterances": utterances,
        "voice_start_client_epoch_s": 0.0,
        "voice_start_server_estimate_s": voice_start_server_s,
        "record_started_server_s": record_started,
        "first_packet_host_t_s": float(timing.get("first_packet_host_t_s", 0.0) or 0.0),
        "last_packet_host_t_s": float(timing.get("last_packet_host_t_s", 0.0) or 0.0),
        "audio_to_record_offset_s": (record_started - voice_start_server_s) if record_started > 0.0 else 0.0,
        "clock_sync_offset_s": 0.0,
        "clock_sync_rtt_s": 0.0,
        "time_mapping": "raw_host_t_s = voice_start_server_estimate_s + audio_time_s",
        "capture": "raspberry_pulseaudio",
        "pulse_source": source,
        "sample_rate_hz": sample_rate,
        "channels": 1,
        "sample_format": "s16le",
        "pcm_auto_gain_applied": bool(gain > 1.0001),
        "pcm_gain_db": float(20.0 * np.log10(max(gain, 1.0))),
        "pcm_target_peak_dbfs": -2.0,
        "pcm_raw_rms_dbfs": float(raw_rms_db),
        "pcm_raw_peak_dbfs": float(raw_peak_db),
        "pcm_rms_dbfs": float(rms_db),
        "pcm_peak_dbfs": float(peak_db),
        "transcription": {
            "state": "not_started",
            "engine": "whisper.cpp",
            "model": _PLAYER_VOICE_STT_MODEL.name,
            "language": _PLAYER_VOICE_STT_LANGUAGE,
            "text": "",
            "segments": [],
            "events": [],
            "event_count": 0,
            "error": "",
        },
        "voice_events": [],
        "created_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    manifest_path = os.path.splitext(target)[0] + ".json"
    manifest_tmp = f"{manifest_path}.{os.getpid()}.tmp"
    try:
        with open(manifest_tmp, "w", encoding="utf-8") as handle:
            json.dump(manifest, handle, ensure_ascii=False, sort_keys=True, indent=2)
            handle.write("\n")
        os.replace(manifest_tmp, manifest_path)
    finally:
        try:
            if os.path.exists(manifest_tmp):
                os.unlink(manifest_tmp)
        except Exception:
            pass
    return manifest


def _player_server_voice_stop(
    api: "ScopeApi",
    *,
    recording_name: str,
    save: bool,
) -> dict[str, Any]:
    global _PLAYER_SERVER_VOICE_PROCESS, _PLAYER_SERVER_VOICE_HANDLE
    with _PLAYER_SERVER_VOICE_LOCK:
        process = _PLAYER_SERVER_VOICE_PROCESS
        handle = _PLAYER_SERVER_VOICE_HANDLE
        state = dict(_PLAYER_SERVER_VOICE_STATE)
        _PLAYER_SERVER_VOICE_PROCESS = None
        _PLAYER_SERVER_VOICE_HANDLE = None
        _PLAYER_SERVER_VOICE_STATE["running"] = False
    if process is not None and process.poll() is None:
        try:
            process.terminate()
            process.wait(timeout=2.0)
        except Exception:
            try:
                process.kill()
                process.wait(timeout=1.0)
            except Exception:
                pass
    if handle is not None:
        try:
            handle.close()
        except Exception:
            pass
    raw_path = str(state.get("raw_path") or "")
    source = str(state.get("source") or "")
    sample_rate_hz = int(state.get("sample_rate_hz", 8000) or 8000)
    started_at = float(state.get("started_at_server_s", 0.0) or 0.0)
    result: dict[str, Any] = {
        "ok": True,
        "available": False,
        "running": False,
        "source": source,
        "sample_rate_hz": sample_rate_hz,
        "message": "Server microphone recording stopped.",
        "error": "",
    }
    try:
        if save and recording_name and raw_path and os.path.exists(raw_path):
            recording_path = _player_recording_path_for_download(api, recording_name)
            if not recording_path or not os.path.exists(recording_path):
                raise RuntimeError("Raw recording was not saved; voice cannot be attached.")
            _player_server_voice_finalize(
                raw_path,
                recording_path,
                voice_start_server_s=started_at,
                source=source,
                sample_rate_hz=sample_rate_hz,
            )
            _player_voice_transcription_start_path(recording_path)
            result = _player_voice_status(api, recording_name)
            result["running"] = False
            result["source"] = source
            result["sample_rate_hz"] = sample_rate_hz
            result["message"] = "Raspberry voice recording saved with the raw recording."
    except Exception as exc:
        result.update({"ok": False, "available": False, "error": str(exc)[:500], "message": "Voice save failed."})
    finally:
        _player_set_voice_playback_inhibit(False, expected_reason="recording")
        try:
            if raw_path and os.path.exists(raw_path):
                os.unlink(raw_path)
        except Exception:
            pass
        with _PLAYER_SERVER_VOICE_LOCK:
            _PLAYER_SERVER_VOICE_STATE.update({
                "enabled": False,
                "running": False,
                "source": source,
                "sample_rate_hz": 0,
                "raw_path": "",
                "started_at_server_s": 0.0,
                "bytes": int(result.get("audio_bytes", 0) or 0),
                "heartbeat_paused": False,
                "message": str(result.get("message") or "Server microphone recording stopped."),
                "error": str(result.get("error") or ""),
            })
    return result


def _player_voice_query_float(query: dict[str, list[str]], name: str, default: float = 0.0) -> float:
    try:
        value = float((query.get(name) or [str(default)])[0] or default)
    except Exception:
        value = float(default)
    if not np.isfinite(value):
        value = float(default)
    return float(value)


def _player_voice_extension(mime_type: str) -> str:
    value = str(mime_type or "").strip().lower()
    if "ogg" in value:
        return ".ogg"
    if "mp4" in value or "m4a" in value:
        return ".m4a"
    if "mpeg" in value or "mp3" in value:
        return ".mp3"
    if "wav" in value:
        return ".wav"
    return ".webm"


def _player_recording_timing(path: str) -> dict[str, float]:
    result = {"record_started_server_s": 0.0, "first_packet_host_t_s": 0.0, "last_packet_host_t_s": 0.0}
    try:
        with np.load(path, allow_pickle=False) as data:
            if "started_t" in data.files:
                result["record_started_server_s"] = float(np.asarray(data["started_t"]).reshape(-1)[0])
            if "host_t" in data.files:
                host_t = np.asarray(data["host_t"], dtype=np.float64).reshape(-1)
                host_t = host_t[np.isfinite(host_t) & (host_t > 0.0)]
                if host_t.size:
                    result["first_packet_host_t_s"] = float(host_t[0])
                    result["last_packet_host_t_s"] = float(host_t[-1])
    except Exception:
        pass
    return result


def _player_voice_utterances(handler: BaseHTTPRequestHandler, recording_path: str, voice_start_server: float) -> list[dict[str, Any]]:
    raw = str(handler.headers.get("X-BMI30-Voice-Utterances", "") or "")[:32768]
    if not raw:
        return []
    try:
        source = json.loads(raw)
    except Exception:
        return []
    if not isinstance(source, list):
        return []
    host_t = np.array([], dtype=np.float64)
    try:
        with np.load(recording_path, allow_pickle=False) as data:
            if "host_t" in data.files:
                host_t = np.asarray(data["host_t"], dtype=np.float64).reshape(-1)
    except Exception:
        host_t = np.array([], dtype=np.float64)
    result: list[dict[str, Any]] = []
    for index, item in enumerate(source[:200]):
        if not isinstance(item, dict):
            continue
        try:
            audio_start = max(0.0, float(item.get("audio_start_s", item.get("start_s", 0.0)) or 0.0))
            audio_end = max(audio_start, float(item.get("audio_end_s", item.get("end_s", audio_start)) or audio_start))
        except Exception:
            continue
        if not np.isfinite(audio_start) or not np.isfinite(audio_end) or audio_end - audio_start < 0.05:
            continue
        server_start = float(voice_start_server + audio_start) if voice_start_server > 0.0 else 0.0
        server_end = float(voice_start_server + audio_end) if voice_start_server > 0.0 else 0.0
        packet_start = -1
        packet_end = -1
        if host_t.size and server_start > 0.0:
            finite = np.isfinite(host_t) & (host_t > 0.0)
            indices = np.flatnonzero(finite)
            values = host_t[finite]
            if values.size:
                start_pos = int(np.searchsorted(values, server_start, side="left"))
                end_pos = int(np.searchsorted(values, server_end, side="right") - 1)
                start_pos = max(0, min(values.size - 1, start_pos))
                end_pos = max(start_pos, min(values.size - 1, end_pos))
                packet_start = int(indices[start_pos])
                packet_end = int(indices[end_pos])
        result.append({
            "utterance_index": int(index),
            "audio_start_s": float(audio_start),
            "audio_end_s": float(audio_end),
            "server_start_s": server_start,
            "server_end_s": server_end,
            "packet_start": packet_start,
            "packet_end": packet_end,
            "source": "browser_energy_vad",
        })
    return result


def _unique_player_upload_path(record_dir: str, name: str) -> str:
    stem, ext = os.path.splitext(name)
    if not ext:
        ext = ".npz"
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    for i in range(1, 1000):
        suffix = f"_import_{stamp}" if i == 1 else f"_import_{stamp}_{i}"
        candidate = os.path.abspath(os.path.join(record_dir, f"{stem}{suffix}{ext}"))
        if os.path.dirname(candidate) == os.path.abspath(record_dir) and not os.path.exists(candidate):
            return candidate
    raise RuntimeError("cannot allocate upload filename")


def _player_record_dir_for_upload(api: "ScopeApi") -> str:
    scope = getattr(api, "scope", None)
    if scope is not None and hasattr(scope, "_player_record_dir_path"):
        return str(scope._player_record_dir_path())
    return str(HOST_DIR / "player_recordings")


def _player_recording_path_for_download(api: "ScopeApi", name: str) -> str:
    scope = getattr(api, "scope", None)
    record_dir = os.path.abspath(_player_record_dir_for_upload(api))
    if scope is not None and hasattr(scope, "_player_record_file_path"):
        path = os.path.abspath(str(scope._player_record_file_path(name)))
    else:
        name_s = os.path.basename(str(name or "").strip())
        if not name_s or name_s == "latest":
            candidates: list[tuple[float, str]] = []
            try:
                for item in os.listdir(record_dir):
                    if item.endswith(".npz"):
                        path_i = os.path.join(record_dir, item)
                        candidates.append((os.path.getmtime(path_i), path_i))
            except Exception:
                candidates = []
            if not candidates:
                return ""
            candidates.sort(reverse=True)
            path = os.path.abspath(candidates[0][1])
        else:
            path = os.path.abspath(os.path.join(record_dir, name_s))
    if not path or os.path.dirname(path) != record_dir or not path.lower().endswith(".npz"):
        raise ValueError("invalid recording file name")
    return path


def _send_player_recording_download(handler: BaseHTTPRequestHandler, api: "ScopeApi", parsed: Any) -> None:
    query = parse_qs(getattr(parsed, "query", "") or "")
    name = str((query.get("name") or ["latest"])[0] or "latest")
    path = _player_recording_path_for_download(api, name)
    if not path or not os.path.exists(path):
        _send_json(handler, {"ok": False, "error": "recording file not found"}, HTTPStatus.NOT_FOUND)
        return
    filename = os.path.basename(path).replace("\\", "_").replace('"', "_")
    size = os.path.getsize(path)
    handler.send_response(HTTPStatus.OK)
    handler.send_header("Content-Type", "application/octet-stream")
    handler.send_header("Content-Disposition", f'attachment; filename="{filename}"')
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(size))
    handler.end_headers()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            handler.wfile.write(chunk)


def _player_voice_status(api: "ScopeApi", name: str) -> dict[str, Any]:
    recording_path = _player_recording_path_for_download(api, name)
    if not recording_path or not os.path.exists(recording_path):
        return {"ok": False, "available": False, "error": "recording file not found"}
    record_dir = os.path.dirname(recording_path)
    stem = os.path.splitext(os.path.basename(recording_path))[0]
    candidates: list[tuple[float, str]] = []
    try:
        for item in os.listdir(record_dir):
            if not item.startswith(f"{stem}.voice") or not item.endswith(".json"):
                continue
            manifest_path = os.path.abspath(os.path.join(record_dir, item))
            if os.path.dirname(manifest_path) == record_dir:
                candidates.append((os.path.getmtime(manifest_path), manifest_path))
    except Exception:
        candidates = []
    candidates.sort(reverse=True)
    for _mtime, manifest_path in candidates:
        try:
            with open(manifest_path, "r", encoding="utf-8") as f:
                manifest = json.load(f)
            if not isinstance(manifest, dict):
                continue
            audio_name = os.path.basename(str(manifest.get("audio_file", "") or ""))
            audio_path = os.path.abspath(os.path.join(record_dir, audio_name))
            if not audio_name or os.path.dirname(audio_path) != record_dir or not os.path.exists(audio_path):
                continue
            transcription = manifest.get("transcription", {})
            transcription = transcription if isinstance(transcription, dict) else {}
            transcript_segments = transcription.get("segments", [])
            transcript_segments = transcript_segments if isinstance(transcript_segments, list) else []
            voice_events = manifest.get("voice_events", transcription.get("events", []))
            voice_events = voice_events if isinstance(voice_events, list) else []
            return {
                "ok": True,
                "available": True,
                "recording_file": os.path.basename(recording_path),
                "audio_file": audio_name,
                "manifest_file": os.path.basename(manifest_path),
                "mime_type": str(manifest.get("mime_type", "audio/webm") or "audio/webm"),
                "audio_bytes": int(os.path.getsize(audio_path)),
                "audio_sha256": str(manifest.get("audio_sha256", "") or ""),
                "audio_duration_s": float(manifest.get("audio_duration_s", 0.0) or 0.0),
                "utterance_count": int(len(manifest.get("utterances", []) or [])),
                "voice_start_server_estimate_s": float(manifest.get("voice_start_server_estimate_s", 0.0) or 0.0),
                "record_started_server_s": float(manifest.get("record_started_server_s", 0.0) or 0.0),
                "first_packet_host_t_s": float(manifest.get("first_packet_host_t_s", 0.0) or 0.0),
                "last_packet_host_t_s": float(manifest.get("last_packet_host_t_s", 0.0) or 0.0),
                "audio_to_record_offset_s": float(manifest.get("audio_to_record_offset_s", 0.0) or 0.0),
                "capture": str(manifest.get("capture", "browser") or "browser"),
                "pulse_source": str(manifest.get("pulse_source", "") or ""),
                "pcm_auto_gain_applied": bool(manifest.get("pcm_auto_gain_applied", False)),
                "pcm_gain_db": float(manifest.get("pcm_gain_db", 0.0) or 0.0),
                "pcm_raw_rms_dbfs": float(manifest.get("pcm_raw_rms_dbfs", -100.0) or -100.0),
                "pcm_raw_peak_dbfs": float(manifest.get("pcm_raw_peak_dbfs", -100.0) or -100.0),
                "pcm_rms_dbfs": float(manifest.get("pcm_rms_dbfs", -100.0) or -100.0),
                "pcm_peak_dbfs": float(manifest.get("pcm_peak_dbfs", -100.0) or -100.0),
                "transcription_available": bool(
                    _PLAYER_VOICE_STT_BINARY.is_file() and _PLAYER_VOICE_STT_MODEL.is_file()
                ),
                "transcription": {
                    "state": str(transcription.get("state", "not_started") or "not_started"),
                    "engine": str(transcription.get("engine", "whisper.cpp") or "whisper.cpp"),
                    "model": str(transcription.get("model", _PLAYER_VOICE_STT_MODEL.name) or _PLAYER_VOICE_STT_MODEL.name),
                    "language": str(transcription.get("language", _PLAYER_VOICE_STT_LANGUAGE) or _PLAYER_VOICE_STT_LANGUAGE),
                    "text": str(transcription.get("text", "") or ""),
                    "segments": transcript_segments[:1000],
                    "events": voice_events[:1000],
                    "event_count": len(voice_events),
                    "elapsed_s": float(transcription.get("elapsed_s", 0.0) or 0.0),
                    "error": str(transcription.get("error", "") or "")[:1000],
                },
            }
        except Exception:
            continue
    return {
        "ok": True,
        "available": False,
        "recording_file": os.path.basename(recording_path),
    }


def _send_player_voice_download(handler: BaseHTTPRequestHandler, api: "ScopeApi", parsed: Any) -> None:
    query = parse_qs(getattr(parsed, "query", "") or "")
    name = str((query.get("name") or ["latest"])[0] or "latest")
    status = _player_voice_status(api, name)
    if not bool(status.get("available", False)):
        _send_json(handler, {"ok": False, "error": "voice annotation not found"}, HTTPStatus.NOT_FOUND)
        return
    record_dir = os.path.abspath(_player_record_dir_for_upload(api))
    filename = os.path.basename(str(status.get("audio_file", "") or ""))
    path = os.path.abspath(os.path.join(record_dir, filename))
    if not filename or os.path.dirname(path) != record_dir or not os.path.exists(path):
        _send_json(handler, {"ok": False, "error": "voice annotation file not found"}, HTTPStatus.NOT_FOUND)
        return
    inline = str((query.get("inline") or ["0"])[0] or "0").strip().lower() in {"1", "true", "yes", "on"}
    playback_inhibit = False
    if inline:
        playback_inhibit = _player_set_voice_playback_inhibit(
            True,
            reason="playback",
            duration_s=max(10.0, float(status.get("audio_duration_s", 0.0) or 0.0) + 5.0),
        )
        if playback_inhibit:
            _player_stop_active_heartbeat()
    safe_name = filename.replace("\\", "_").replace('"', "_")
    size = os.path.getsize(path)
    handler.send_response(HTTPStatus.OK)
    handler.send_header("Content-Type", str(status.get("mime_type", "audio/webm") or "audio/webm"))
    handler.send_header("Content-Disposition", f'{"inline" if inline else "attachment"}; filename="{safe_name}"')
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("X-BMI30-Bluetooth-Playback-Inhibit", "1" if playback_inhibit else "0")
    handler.send_header("Content-Length", str(size))
    handler.end_headers()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            handler.wfile.write(chunk)


def _handle_player_voice_upload(handler: BaseHTTPRequestHandler, api: "ScopeApi", parsed: Any) -> dict[str, Any]:
    try:
        length = int(handler.headers.get("Content-Length", "0") or "0")
    except Exception:
        length = 0
    if length <= 0:
        raise ValueError("empty voice upload")
    limit = _player_voice_upload_limit_bytes()
    if length > limit:
        raise ValueError(f"voice upload too large ({length} bytes, limit {limit} bytes)")
    query = parse_qs(getattr(parsed, "query", "") or "")
    recording_name = str((query.get("name") or [""])[0] or "").strip()
    recording_path = _player_recording_path_for_download(api, recording_name)
    if not recording_path or not os.path.exists(recording_path):
        raise ValueError("recording file not found for voice annotation")
    record_dir = os.path.dirname(recording_path)
    stem = os.path.splitext(os.path.basename(recording_path))[0]
    mime_type = str(handler.headers.get("Content-Type", "") or (query.get("mime") or ["audio/webm"])[0]).split("\r", 1)[0].split("\n", 1)[0].strip()[:120]
    if not (mime_type.lower().startswith("audio/") or "webm" in mime_type.lower()):
        raise ValueError("unsupported voice content type")
    ext = _player_voice_extension(mime_type)
    target = os.path.abspath(os.path.join(record_dir, f"{stem}.voice{ext}"))
    if os.path.dirname(target) != record_dir:
        raise ValueError("invalid voice annotation path")
    tmp_path = os.path.join(record_dir, f".{stem}.voice.{os.getpid()}.{int(time.time() * 1000)}.upload")
    total = 0
    digest = hashlib.sha256()
    try:
        remaining = length
        with open(tmp_path, "wb") as f:
            while remaining > 0:
                chunk = handler.rfile.read(min(1024 * 1024, remaining))
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError("voice upload exceeded size limit")
                digest.update(chunk)
                f.write(chunk)
                remaining -= len(chunk)
        if total != length:
            raise ValueError(f"incomplete voice upload ({total}/{length} bytes)")
        uploaded_hash = digest.hexdigest()
        if os.path.exists(target) and _sha256_file(target) != uploaded_hash:
            for index in range(2, 1000):
                candidate = os.path.abspath(os.path.join(record_dir, f"{stem}.voice_{index}{ext}"))
                if os.path.dirname(candidate) == record_dir and not os.path.exists(candidate):
                    target = candidate
                    break
            else:
                raise RuntimeError("cannot allocate voice annotation filename")
        if os.path.exists(target):
            os.unlink(tmp_path)
        else:
            os.replace(tmp_path, target)
    except Exception:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass
        raise
    timing = _player_recording_timing(recording_path)
    voice_start_server = _player_voice_query_float(query, "voice_start_server_s", 0.0)
    record_started_server = float(timing.get("record_started_server_s", 0.0) or 0.0)
    utterances = _player_voice_utterances(handler, recording_path, voice_start_server)
    manifest = {
        "schema": "bmi30-player-voice-v1",
        "recording_file": os.path.basename(recording_path),
        "audio_file": os.path.basename(target),
        "mime_type": mime_type or "audio/webm",
        "audio_bytes": int(total),
        "audio_sha256": uploaded_hash,
        "audio_duration_s": max(0.0, _player_voice_query_float(query, "duration_s", 0.0)),
        "utterances": utterances,
        "voice_start_client_epoch_s": _player_voice_query_float(query, "voice_start_client_s", 0.0),
        "voice_start_server_estimate_s": voice_start_server,
        "record_started_server_s": record_started_server,
        "first_packet_host_t_s": float(timing.get("first_packet_host_t_s", 0.0) or 0.0),
        "last_packet_host_t_s": float(timing.get("last_packet_host_t_s", 0.0) or 0.0),
        "audio_to_record_offset_s": (record_started_server - voice_start_server) if record_started_server > 0.0 and voice_start_server > 0.0 else 0.0,
        "clock_sync_offset_s": _player_voice_query_float(query, "clock_offset_s", 0.0),
        "clock_sync_rtt_s": max(0.0, _player_voice_query_float(query, "clock_rtt_s", 0.0)),
        "time_mapping": "raw_host_t_s = voice_start_server_estimate_s + audio_time_s",
        "uploaded_at_server_s": time.time(),
        "created_at": datetime.datetime.now().isoformat(timespec="seconds"),
        "client_user_agent": str(handler.headers.get("User-Agent", "") or "")[:240],
    }
    manifest_path = os.path.splitext(target)[0] + ".json"
    manifest_tmp = f"{manifest_path}.{os.getpid()}.tmp"
    try:
        with open(manifest_tmp, "w", encoding="utf-8") as f:
            json.dump(manifest, f, ensure_ascii=False, sort_keys=True, indent=2)
            f.write("\n")
        os.replace(manifest_tmp, manifest_path)
    finally:
        try:
            if os.path.exists(manifest_tmp):
                os.unlink(manifest_tmp)
        except Exception:
            pass
    _player_voice_transcription_start_path(recording_path)
    result = _player_voice_status(api, os.path.basename(recording_path))
    result["uploaded_bytes"] = int(total)
    return result


def _handle_player_recording_upload(handler: BaseHTTPRequestHandler, api: "ScopeApi", parsed: Any) -> dict[str, Any]:
    try:
        length = int(handler.headers.get("Content-Length", "0") or "0")
    except Exception:
        length = 0
    if length <= 0:
        raise ValueError("empty upload")
    limit = _player_upload_limit_bytes()
    if length > limit:
        raise ValueError(f"upload too large ({length} bytes, limit {limit} bytes)")
    query = parse_qs(getattr(parsed, "query", "") or "")
    filename = _safe_player_upload_name(
        handler.headers.get("X-BMI30-Filename")
        or handler.headers.get("X-Filename")
        or (query.get("name") or [""])[0]
    )
    record_dir = os.path.abspath(_player_record_dir_for_upload(api))
    os.makedirs(record_dir, exist_ok=True)
    target = os.path.abspath(os.path.join(record_dir, filename))
    if os.path.dirname(target) != record_dir:
        raise ValueError("invalid recording file name")
    tmp_path = os.path.join(record_dir, f".{filename}.{os.getpid()}.{int(time.time() * 1000)}.upload")
    total = 0
    digest = hashlib.sha256()
    try:
        remaining = length
        with open(tmp_path, "wb") as f:
            while remaining > 0:
                chunk = handler.rfile.read(min(1024 * 1024, remaining))
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError("upload exceeded size limit")
                digest.update(chunk)
                f.write(chunk)
                remaining -= len(chunk)
        if total != length:
            raise ValueError(f"incomplete upload ({total}/{length} bytes)")
        uploaded_hash = digest.hexdigest()
        if os.path.exists(target):
            try:
                same = _sha256_file(target) == uploaded_hash
            except Exception:
                same = False
            if same:
                try:
                    os.unlink(tmp_path)
                except Exception:
                    pass
            else:
                target = _unique_player_upload_path(record_dir, filename)
                os.replace(tmp_path, target)
        else:
            os.replace(tmp_path, target)
    except Exception:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass
        raise
    max_points = int((query.get("max_points") or ["600"])[0] or 600)
    max_frames = int((query.get("max_frames") or ["800"])[0] or 800)
    load_result = api.submit(
        "player_record_load",
        {"name": os.path.basename(target), "max_points": max_points, "max_frames": max_frames},
        timeout=_player_load_timeout_seconds(),
    )
    if isinstance(load_result, dict):
        load_result["uploaded_file"] = filename
        load_result["stored_file"] = os.path.basename(target)
        load_result["uploaded_bytes"] = int(total)
        return load_result
    return {"ok": False, "error": "upload load failed"}


class ServiceHandler(BaseHTTPRequestHandler):
    server_version = "BMI30CoreService/001"

    def log_message(self, fmt: str, *args: Any) -> None:
        if os.getenv("BMI30_SERVICE_HTTP_LOG", "0").lower() in {"1", "true", "yes", "on"}:
            super().log_message(fmt, *args)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        api = API
        if api is None:
            _send_json(self, {"ok": False, "error": "service not ready"}, HTTPStatus.SERVICE_UNAVAILABLE)
            return
        if parsed.path in {"/", "/index.html"}:
            html = SERVICE_HTML.encode("utf-8")
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Permissions-Policy", "microphone=(self)")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(html)))
            self.end_headers()
            self.wfile.write(html)
            return
        if parsed.path in {"/health", "/api/health"}:
            _send_json(self, {"ok": True, "service": "BMI30", "version": SERVICE_VERSION})
            return
        if parsed.path == "/api/relay":
            _send_json(self, {"ok": True, "relay": api.relay_service.snapshot()})
            return
        if parsed.path == "/api/tx-phase":
            _send_json(self, api.tx_phase())
            return
        if parsed.path == "/api/status":
            _send_json(self, api.status())
            return
        if parsed.path == "/api/dc-config":
            _send_json(self, api.submit("read_dc_config", {}, timeout=3.0))
            return
        if parsed.path == '/api/detection-review':
            query = parse_qs(parsed.query)
            sources = api._fire_frame_sources(api.scope,
                int((query.get('fire_seq0') or ['0'])[0]), int((query.get('fire_seq1') or ['0'])[0]),
                int((query.get('review_seq') or ['0'])[0]))
            event = sources.get('anchor')
            _send_json(self, {'ok': event is not None, 'event': event, 'error': None if event is not None else 'Event expired'})
            return
        if parsed.path == "/api/frame":
            query = parse_qs(parsed.query)
            max_points = int((query.get("max_points") or ["600"])[0])
            fire_seq0 = int((query.get("fire_seq0") or ["0"])[0] or 0)
            fire_seq1 = int((query.get("fire_seq1") or ["0"])[0] or 0)
            review_seq = int((query.get("review_seq") or ["0"])[0] or 0)
            _send_json(self, api.frame(max_points=max_points, fire_seq0=fire_seq0, fire_seq1=fire_seq1, review_seq=review_seq))
            return
        if parsed.path == "/api/frame.bin":
            query = parse_qs(parsed.query)
            max_points = int((query.get("max_points") or ["600"])[0])
            channels = (query.get("channels") or ["both"])[0]
            try:
                since = float((query.get("since") or ["0"])[0] or 0.0)
            except Exception:
                since = 0.0
            fire_seq0 = int((query.get("fire_seq0") or ["0"])[0] or 0)
            fire_seq1 = int((query.get("fire_seq1") or ["0"])[0] or 0)
            _send_binary(
                self,
                api.frame_binary(
                    max_points=max_points,
                    channels=channels,
                    since=since,
                    fire_seq0=fire_seq0,
                    fire_seq1=fire_seq1,
                    review_seq=int((query.get("review_seq") or ["0"])[0] or 0),
                ),
            )
            return
        if parsed.path == "/api/player-recording-download":
            try:
                _send_player_recording_download(self, api, parsed)
            except Exception as exc:
                _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        if parsed.path == "/api/player-recording-voice-status":
            try:
                query = parse_qs(parsed.query)
                name = str((query.get("name") or ["latest"])[0] or "latest")
                _send_json(self, _player_voice_status(api, name))
            except Exception as exc:
                _send_json(self, {"ok": False, "available": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        if parsed.path == "/api/player-recording-voice-download":
            try:
                _send_player_voice_download(self, api, parsed)
            except Exception as exc:
                _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        if parsed.path == "/api/time":
            _send_json(self, {"ok": True, "server_epoch_s": time.time(), "server_monotonic_s": time.monotonic()})
            return
        _send_json(self, {"ok": False, "error": "not found"}, HTTPStatus.NOT_FOUND)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        api = API
        if api is None:
            _send_json(self, {"ok": False, "error": "service not ready"}, HTTPStatus.SERVICE_UNAVAILABLE)
            return
        if parsed.path == "/api/player-recording-upload":
            try:
                _send_json(self, _handle_player_recording_upload(self, api, parsed))
            except Exception as exc:
                _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        if parsed.path == "/api/player-recording-voice-upload":
            try:
                _send_json(self, _handle_player_voice_upload(self, api, parsed))
            except Exception as exc:
                _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        if parsed.path != "/api/command":
            _send_json(self, {"ok": False, "error": "not found"}, HTTPStatus.NOT_FOUND)
            return
        try:
            length = int(self.headers.get("Content-Length", "0") or "0")
            raw = self.rfile.read(min(length, 1024 * 1024))
            payload = json.loads(raw.decode("utf-8") or "{}") if raw else {}
            if not isinstance(payload, dict):
                raise ValueError("JSON object expected")
            action = str(payload.get("action") or "")
            params = payload.get("params")
            if not isinstance(params, dict):
                params = {k: v for k, v in payload.items() if k not in {"action", "params"}}
            if not action:
                raise ValueError("missing action")
            action_l = action.strip().lower()
            if action_l in {"player_record_load", "player_raw_record_load"}:
                timeout = _player_load_timeout_seconds()
            elif action_l.startswith(("player_", "player_raw_")):
                timeout = 60.0
            elif action_l in {"rs485_ident", "rs485_identity", "scan_rs485_ident", "refresh_rs485_ident"}:
                timeout = 20.0
            else:
                timeout = 8.0
            _log_api_command(self, action_l, params)
            if action_l == "relay":
                _send_json(self, api.relay_service.command(params))
                return
            if action_l == "tx_phase":
                _send_json(self, api.tx_phase(params))
                return
            _send_json(self, api.submit(action, params, timeout=timeout))
        except Exception as exc:
            _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)


