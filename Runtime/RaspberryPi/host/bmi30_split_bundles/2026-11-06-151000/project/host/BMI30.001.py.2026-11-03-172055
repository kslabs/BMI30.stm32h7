def _player_set_voice_playback_inhibit(
    active: bool,
    *,
    reason: str = "recording",
    duration_s: float = 3600.0,
    expected_reason: str = "",
) -> bool:
    path = _player_voice_inhibit_path()
    try:
        if not active:
            if os.path.exists(path):
                if expected_reason:
                    try:
                        with open(path, "r", encoding="utf-8") as handle:
                            current = json.load(handle)
                        if str((current or {}).get("reason") or "recording") != expected_reason:
                            return True
                    except Exception:
                        pass
                os.unlink(path)
            return False
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp_path = f"{path}.{os.getpid()}.tmp"
        started_at = time.time()
        safe_reason = str(reason or "recording").strip().lower() or "recording"
        lease_s = max(5.0, min(3600.0, float(duration_s)))
        try:
            with open(tmp_path, "w", encoding="utf-8") as handle:
                json.dump({
                    "pid": os.getpid(),
                    "started_at": started_at,
                    "expires_at": started_at + lease_s,
                    "reason": safe_reason,
                }, handle, sort_keys=True)
                handle.write("\n")
            os.replace(tmp_path, path)
        finally:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        return True
    except Exception as exc:
        print(f"[PLAYER-VOICE] playback inhibit failed: {exc}", flush=True)
        return False


def _player_stop_active_heartbeat() -> int:
    ok, output = _player_pactl("list", "sink-inputs", timeout=4.0)
    if not ok or not output:
        return 0
    heartbeat_name = os.path.basename(
        os.getenv(
            "BMI30_BLUETOOTH_HEARTBEAT_CUE_FILE",
            "/usr/share/sounds/freedesktop/stereo/message.oga",
        )
    ).lower()
    stopped = 0
    for block in re.split(r"(?=^Sink Input #)", output, flags=re.MULTILINE):
        index_match = re.search(r"^Sink Input #(\d+)", block, flags=re.MULTILINE)
        if not index_match:
            continue
        lower = block.lower()
        if 'application.name = "paplay"' not in lower or heartbeat_name not in lower:
            continue
        killed, _message = _player_pactl("kill-sink-input", index_match.group(1), timeout=2.0)
        if killed:
            stopped += 1
    return stopped


def _player_server_voice_source() -> str:
    info_ok, info = _player_pactl("info")
    default_source = ""
    if info_ok:
        match = re.search(r"^Default Source:\s*(\S+)\s*$", info, flags=re.MULTILINE)
        default_source = match.group(1) if match else ""
    sources_ok, sources = _player_pactl("list", "short", "sources")
    if not sources_ok:
        return ""
    available: list[str] = []
    for line in sources.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        name = parts[1].strip()
        lower = name.lower()
        if ".monitor" in lower:
            continue
        available.append(name)
    explicit_source = str(os.getenv("BMI30_PLAYER_VOICE_SOURCE", "") or "").strip()
    if explicit_source in available:
        return explicit_source
    usb_microphone = next(
        (
            name for name in available
            if name.lower().startswith("alsa_input.")
            and any(token in name.lower() for token in ("c920e", "webcam", "usb"))
        ),
        "",
    )
    if usb_microphone:
        return usb_microphone
    if default_source in available:
        return default_source
    bluetooth_sources = [
        name for name in available
        if "bluez_source" in name.lower() or "bluez_input" in name.lower()
    ]
    handsfree = next(
        (name for name in bluetooth_sources if any(token in name.lower() for token in ("handsfree", "headset", "hfp", "hsp"))),
        "",
    )
    return handsfree or (bluetooth_sources[0] if bluetooth_sources else "")


def _player_server_voice_sample_rate(source: str) -> int:
    """Return the native Pulse/PipeWire rate for the selected microphone input."""
    ok, output = _player_pactl("list", "short", "sources")
    if ok:
        for line in output.splitlines():
            parts = line.split()
            if len(parts) < 2 or parts[1].strip() != source:
                continue
            match = re.search(r"\b(\d{4,6})Hz\b", line, flags=re.IGNORECASE)
            if match:
                rate = int(match.group(1))
                if 8000 <= rate <= 48000:
                    return rate
    return 32000 if any(token in source.lower() for token in ("c920e", "webcam")) else 8000


def _player_server_voice_capture_command(source: str, sample_rate_hz: int = 8000) -> list[str]:
    try:
        sample_rate = int(sample_rate_hz)
    except Exception:
        sample_rate = 8000
    if not 8000 <= sample_rate <= 48000:
        sample_rate = 8000
    return _player_pulse_command(
        "parec",
        f"--device={source}",
        "--format=s16le",
        f"--rate={sample_rate}",
        "--channels=1",
        "--latency-msec=250",
        "--process-time-msec=100",
        "--client-name=BMI30 Player Voice Recorder",
        "--raw",
    )


def _player_server_voice_snapshot() -> dict[str, Any]:
    with _PLAYER_SERVER_VOICE_LOCK:
        state = dict(_PLAYER_SERVER_VOICE_STATE)
    raw_path = str(state.get("raw_path") or "")
    if raw_path:
        try:
            state["bytes"] = int(os.path.getsize(raw_path))
