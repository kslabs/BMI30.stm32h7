def _working_window_snapshot(scope: Any, base_len: int, selected_mode: int) -> dict[str, Any]:
    default_start = _int_env("BMI30_WORK_WINDOW_START", _int_env("BMI30_ROI_START", 280))
    default_len = _int_env("BMI30_WORK_WINDOW_LEN", _int_env("BMI30_ROI_LEN", 200))
    length = max(1, int(default_len))
    start = max(0, int(default_start))
    try:
        candidate = int(getattr(scope, "working_window_start"))
        if candidate >= 0:
            start = candidate
    except Exception:
        pass
    if base_len > 0:
        length = min(length, base_len)
        start = min(start, max(0, base_len - length))
    end = start + length
    return {
        "enabled": bool(int(selected_mode) in (1, 2, 3) and base_len > length),
        "start": start,
        "end": end,
        "length": length,
    }


class ScopeApi:
    def __init__(self, scope: Any, qtcore: Any):
        self.scope = scope
        from usb_vendor.relay_control import RelayService
        relay_config = Path(os.getenv("BMI30_CONFIG_JSON", str(HOST_DIR / "bmi30_config.json"))).parent / "bmi30_relay.json"
        self.relay_service = RelayService(scope, relay_config)
        scope._relay_service = self.relay_service
        self.qtcore = qtcore
        self.last_run_mode = 3
        self._restore_tim2_after_stop = False
        self._restore_tim2_valid = False
        self._identify_seq = 0
        self._identify_active = False
        self._identify_previous_manual_pattern = 0
        self._identify_previous_nonaddr_test = False
        self._status_cache: dict[str, Any] | None = None
        try:
            selected = int(scope.num_group.checkedId())
            if 1 <= selected <= 7:
                self.last_run_mode = selected
        except Exception:
            pass
        self.commands: "queue.Queue[dict[str, Any]]" = queue.Queue()
        self._timer = qtcore.QTimer()
        self._timer.setInterval(40)
        self._timer.timeout.connect(self._drain_commands)
        self._timer.start()

    @staticmethod
    def _try_data_lock(scope: Any) -> tuple[Any, bool]:
        """Acquire the frame-data lock briefly, without piling up HTTP workers."""
        try:
            data_lock = getattr(scope, "data_lock", None)
        except Exception:
            return None, False
        if data_lock is None:
            return None, True
        try:
            return data_lock, bool(data_lock.acquire(timeout=API_DATA_LOCK_TIMEOUT_S))
        except TypeError:
            # Compatibility with lock-like objects that only accept ``blocking``.
            try:
                return data_lock, bool(data_lock.acquire(False))
            except Exception:
                return data_lock, False
        except Exception:
            return data_lock, False

    def _busy_status(self, connected: bool, selected_mode: int) -> dict[str, Any]:
        cached = getattr(self, "_status_cache", None)
        if isinstance(cached, dict):
            payload = dict(cached)
        else:
            stream = getattr(self.scope, "stream", None)
            payload = {
                "ok": True,
                "service": {
                    "version": SERVICE_VERSION,
                    "engine_source": str(ENGINE_FILE),
                    "uptime_s": time.time() - START_T,
                },
                "connection": {
                    "connected": bool(connected),
                    "connecting": bool(getattr(self.scope, "_connecting", False)),
                    "disconnected": bool(getattr(stream, "disconnected", False)) if stream is not None else False,
                },
                "mode": {"selected": int(selected_mode)},
                "frames": {},
                "fps": {},
                "detector": {},
                "normalization": {},
                "smoothing": {},
                "optimize": {},
            }
        payload.update(
            {
                "ok": True,
                "busy": True,
                "stale": True,
                "retry_after_ms": API_BUSY_RETRY_MS,
            }
        )
        return _json_safe(payload)

    @staticmethod
    def _busy_frame(scope: Any) -> dict[str, Any]:
        try:
            frame_ts = float(getattr(scope, "last_frame_t", 0.0) or 0.0)
        except Exception:
            frame_ts = 0.0
        return {
            "ok": True,
            "available": False,
            "not_modified": True,
            "busy": True,
            "retry_after_ms": API_BUSY_RETRY_MS,
            "last_frame_t": frame_ts,
        }

    def tx_phase(self, params=None) -> dict[str, Any]:
        # USB readback runs on the HTTP thread, never on the detector event loop.
        from usb_vendor.capabilities import FeatureUnavailable
        from bmi30_phase_adaptation import state as rx_phase_state
        stream = getattr(self.scope, "stream", None)
        try:
            if stream is None:
                raise RuntimeError("USB is not connected")
            control = stream.tx_phase_control()
            if params is None:
                state = control.read()
            else:
                state = control.set_phase(params.get("channel"), params.get("phase"), persist=True)
            if getattr(self.scope, "stream", None) is not stream:
                raise RuntimeError("USB connection changed; read TX phases again")
            from bmi30_phase_adaptation import state as rx_phase_state
            return {"ok": True, "available": True, "supported": True, "tx_phase": state,
                    "phase_adaptation": rx_phase_state(self.scope), "persisted": params is not None}
        except FeatureUnavailable as exc:
            return {"ok": params is None, "available": False, "supported": False,
                    "tx_phase": {"available": False, "supported": False},
                    "phase_adaptation": rx_phase_state(self.scope), "persisted": False,
                    "error": str(exc), "reason": "unsupported"}
        except Exception as exc:
            return {"ok": False, "error": str(exc)}

    def submit(self, action: str, params: dict[str, Any] | None = None, timeout: float = 8.0) -> dict[str, Any]:
        item: dict[str, Any] = {
            "action": str(action),
            "params": dict(params or {}),
            "event": threading.Event(),
            "result": None,
        }
        self.commands.put(item)
        if not item["event"].wait(max(0.1, float(timeout))):
            return {"ok": False, "error": "command timeout", "action": action}
        result = item.get("result")
        if isinstance(result, dict):
            return result
        return {"ok": False, "error": "empty command result", "action": action}

    def _drain_commands(self) -> None:
        while True:
            try:
                item = self.commands.get_nowait()
            except queue.Empty:
                return
            try:
                item["result"] = self._execute(str(item.get("action") or ""), dict(item.get("params") or {}))
            except Exception as exc:
                item["result"] = {"ok": False, "error": str(exc), "trace": traceback.format_exc(limit=5)}
            finally:
                try:
                    item["event"].set()
                except Exception:
                    pass

    def _set_tim2_desired(self, enabled: bool) -> None:
        scope = self.scope
        enabled = bool(enabled)
        try:
            scope.tim2_enabled = enabled
        except Exception:
            pass
        try:
            btn = getattr(scope, "btn_tim2", None)
            if btn is not None:
                try:
                    old_blocked = btn.blockSignals(True)
                except Exception:
                    old_blocked = None
                try:
                    btn.setChecked(enabled)
                finally:
                    try:
                        if old_blocked is not None:
                            btn.blockSignals(old_blocked)
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            scope._update_tim2_btn_style()
        except Exception:
            pass

    def _disable_tim2_for_stop(self) -> None:
        scope = self.scope
        try:
            self._restore_tim2_after_stop = bool(getattr(scope, "tim2_enabled", False))
            self._restore_tim2_valid = True
        except Exception:
            self._restore_tim2_after_stop = False
            self._restore_tim2_valid = True
        self._set_tim2_desired(False)
        try:
            scope.tim2_pending = False
            scope.tim2_applied = False
        except Exception:
            pass
        stream = getattr(scope, "stream", None)
        if stream is not None:
            try:
                scope._send_tim2_enable(False)
            except Exception:
                pass
            try:
                scope._send_tx_enable(False)
            except Exception:
                pass
        try:
            scope._update_tim2_btn_style()
        except Exception:
            pass

    def _restore_tim2_for_start(self) -> None:
        if not self._restore_tim2_valid:
            return
        self._set_tim2_desired(bool(self._restore_tim2_after_stop))
        self._restore_tim2_valid = False

    def _read_dc_config(self) -> dict[str, Any]:
        stream = getattr(self.scope, "stream", None)
        if stream is None:
            raise RuntimeError("stream is not connected")
        if not hasattr(stream, "get_dc_config"):
            raise RuntimeError("stream does not support get_dc_config")
        cfg = _dc_config_from_device(stream.get_dc_config())
        if not bool(cfg.get("available", False)):
            return {"ok": False, "error": "device returned unsupported DC config", "dc_config": cfg}
        return {"ok": True, "dc_config": _dc_config_for_api(cfg, self.scope)}

    def _stop_stream_keep_mode(self) -> int:
        scope = self.scope
        try:
            selected = int(scope.num_group.checkedId())
        except Exception:
            selected = int(self.last_run_mode or 3)
        if 1 <= selected <= 7:
            self.last_run_mode = selected
        # DC learning is independent from the USB stream. Keep the last
        # Portal-selected value while the data stream is stopped.
        self._disable_tim2_for_stop()
        if hasattr(scope, "_reset_stream_runtime_state"):
            scope._reset_stream_runtime_state(reason="api_stop_keep_mode")
            try:
                scope._stream_user_stopped = True
            except Exception:
                pass
        else:
            try:
                scope._send_stop_stream()
            except Exception:
                pass
            try:
                stream = getattr(scope, "stream", None)
                if stream is not None:
                    stream.close()
            except Exception:
                pass
            try:
                scope.stream = None
            except Exception:
                pass
        try:
            scope._set_status(f"Stream stopped, mode {selected} preserved", hold_sec=2.0)
        except Exception:
            pass
        return selected

    def _start_device_identification(self, params: dict[str, Any]) -> dict[str, Any]:
        """Temporarily light both addressable and non-addressable device LEDs."""
        scope = self.scope
        if not hasattr(scope, "_set_group_led_manual_test_pattern"):
            raise RuntimeError("engine does not support addressable LED test patterns")
        if not hasattr(scope, "_set_non_addressable_led"):
            raise RuntimeError("engine does not support the non-addressable LED")
        try:
            default_pattern = int(os.getenv("BMI30_IDENTIFY_LED_PATTERN", "13"), 0)
        except Exception:
            default_pattern = 13
        pattern = _led_pattern_value(params.get("pattern", params.get("pattern_id", default_pattern)))
        if pattern <= 0:
            pattern = 13  # STM32 TEST_DRIP
        try:
            default_duration_s = float(os.getenv("BMI30_IDENTIFY_DURATION_S", "5.0"))
        except Exception:
            default_duration_s = 5.0
        try:
            duration_s = float(params.get("duration_s", params.get("seconds", default_duration_s)))
        except Exception:
            duration_s = default_duration_s
        duration_s = max(0.5, min(60.0, duration_s))

        if not self._identify_active:
            self._identify_previous_manual_pattern = _led_pattern_value(
                getattr(scope, "_group_led_manual_test_pattern", 0)
            )
            self._identify_previous_nonaddr_test = bool(
                getattr(scope, "_non_addressable_led_test_enabled", False)
            )
        self._identify_seq += 1
        identify_seq = self._identify_seq
        self._identify_active = True

        addressable_ok = bool(scope._set_group_led_manual_test_pattern(pattern))
        nonaddr_snapshot = scope._set_non_addressable_led(
            test_enabled=True,
            persist=False,
        )
        try:
            scope._set_status(
                f"Identify device: LED test {duration_s:g} s",
                hold_sec=min(2.0, duration_s),
            )
        except Exception:
            pass

        def _finish_identification() -> None:
            if identify_seq != self._identify_seq:
                return
            previous_pattern = _led_pattern_value(self._identify_previous_manual_pattern)
            previous_nonaddr_test = bool(self._identify_previous_nonaddr_test)
            self._identify_active = False
            try:
                scope._set_group_led_manual_test_pattern(previous_pattern)
                if hasattr(scope, "_group_led_apply_current_state"):
                    scope._group_led_apply_current_state(force=True)
            except Exception as exc:
                print(f"[BMI30.001] addressable identify restore failed: {exc}", flush=True)
            try:
                scope._set_non_addressable_led(
                    test_enabled=previous_nonaddr_test,
                    persist=False,
                )
            except Exception as exc:
                print(f"[BMI30.001] non-addressable identify restore failed: {exc}", flush=True)
            try:
                scope._set_status("Device identification complete", hold_sec=1.2)
            except Exception:
                pass

        _call_qt_later_s(duration_s, _finish_identification)
        return {
            "ok": bool(addressable_ok),
            "identifying": True,
            "duration_s": duration_s,
            "led_pattern": pattern,
            "addressable_led": {"ok": bool(addressable_ok), "pattern": pattern},
            "non_addressable_led": nonaddr_snapshot,
        }

    def _start_dc_startup_compensation(self, selected: int, reason: str = "", force: bool = False) -> bool:
        """Run lightning until 99% residual reduction or the configured timeout."""
        try:
            selected = int(selected)
        except Exception:
            selected = 0
        if selected != 5:
            return False
        dc_cfg = _load_default_dc_config()
        timeout_s = _dc_float(
            dc_cfg.get("lightning_timeout_s", DC_LIGHTNING_DURATION_S),
            DC_LIGHTNING_DURATION_S,
            DC_LIGHTNING_TIMEOUT_MIN_S,
        )
        initial_metric = _dc_lightning_offset_metric(self.scope)
        initial_off = (
            float(initial_metric.get("max_mean_off", 0.0))
            if bool(initial_metric.get("ready", False))
            else None
        )
        initial_frame_t = float(initial_metric.get("frame_t", 0.0) or 0.0)
        ok = _apply_default_dc_config(
            self.scope,
            reason=f"{reason}:startup",
            profile="startup",
            force=bool(force),
        )
        if ok:
            try:
                seq = int(getattr(self.scope, "_host_dc_startup_seq", 0) or 0) + 1
                started_t = time.time()
                until = started_t + timeout_s
                self.scope._host_dc_startup_seq = seq
                self.scope._host_dc_desired_profile = "work"
                self.scope._host_dc_startup_until = until
                self.scope._host_dc_startup_restore_profile = "work"
                self.scope._host_dc_lightning_initial_off = initial_off
                self.scope._host_dc_lightning_current_off = initial_off
                self.scope._host_dc_lightning_progress_percent = 0.0
                self.scope._host_dc_lightning_completion_reason = "running"
                self.scope._host_dc_lightning_timeout_s = timeout_s
            except Exception:
                seq = 0
                started_t = time.time()
                until = started_t + timeout_s

            def _finish_lightning() -> None:
                try:
                    if seq != int(getattr(self.scope, "_host_dc_startup_seq", 0) or 0):
                        return
                    now = time.time()
                    deadline = float(getattr(self.scope, "_host_dc_startup_until", until) or until)
                    metric = _dc_lightning_offset_metric(self.scope)
                    current_off = None
                    progress_percent = 0.0
                    target_reached = False
                    if bool(metric.get("ready", False)):
                        current_off = float(metric.get("max_mean_off", 0.0))
                        metric_frame_t = float(metric.get("frame_t", 0.0) or 0.0)
                        if initial_off is not None and metric_frame_t > initial_frame_t:
                            if initial_off <= 0.5:
                                progress_percent = 100.0 if current_off <= 0.5 else 0.0
                            else:
                                progress_percent = 100.0 * (1.0 - (current_off / initial_off))
                            progress_percent = max(0.0, min(100.0, progress_percent))
                            target_reached = progress_percent >= float(DC_LIGHTNING_TARGET_PERCENT)
                    self.scope._host_dc_lightning_current_off = current_off
                    self.scope._host_dc_lightning_progress_percent = progress_percent
                    timed_out = now >= deadline
                    if not target_reached and not timed_out:
                        _call_qt_later_s(min(0.05, max(0.01, deadline - now)), _finish_lightning)
                        return
                    completion_reason = "target_99pct" if target_reached else "timer"
                    self.scope._host_dc_startup_until = 0.0
                    self.scope._host_dc_startup_restore_profile = ""
                    self.scope._host_dc_lightning_completion_reason = completion_reason
                    if int(self.scope.num_group.checkedId()) <= 0:
                        return
                    self.scope._host_dc_desired_profile = "work"
                    restored = _apply_default_dc_config(
                        self.scope,
                        reason=f"{reason}:lightning_complete_{completion_reason}",
                        profile="work",
                    )
                    if restored:
                        work_s = float(dc_cfg["work_settle_s"])
                        finish_text = "99%" if target_reached else f"таймер {timeout_s:g} с"
                        self.scope._set_status(
                            f"DC: молния завершена ({finish_text}), Work {work_s:g} с",
                            hold_sec=2.0,
                        )
                        print(
                            f"[DC] lightning complete reason={completion_reason} "
                            f"progress={progress_percent:.2f}% initial_off={initial_off} current_off={current_off} "
                            f"elapsed_s={now - started_t:.3f} timeout_s={timeout_s:g}",
                            flush=True,
                        )
                except Exception as exc:
                    print(f"[DC] lightning completion failed: {exc}", flush=True)

            _call_qt_later_s(min(0.05, timeout_s), _finish_lightning)
            try:
                self.scope._set_status(
                    f"DC: молния до {DC_LIGHTNING_TARGET_PERCENT}% или {timeout_s:g} с, затем Work",
                    hold_sec=min(2.0, timeout_s),
                )
            except Exception:
                pass
        return bool(ok)

    def _apply_mode5_work_dc(self, reason: str = "") -> None:
        try:
            if int(self.scope.num_group.checkedId()) != 5:
                return
        except Exception:
            return
        try:
            self.scope._host_dc_desired_profile = "work"
        except Exception:
            pass
        _apply_default_dc_config(self.scope, reason=f"{reason}:work", profile="work")

    def _execute(self, action: str, params: dict[str, Any]) -> dict[str, Any]:
        scope = self.scope
        action = action.strip().lower()
        if action == "phase_adaptation":
            from bmi30_phase_adaptation import set_enabled
            policy = set_enabled(scope, params.get("enabled"), persist=True)
            return {"ok": True, "phase_adaptation": policy, "persisted": True}
        if action == "communication_recovery_ack":
            generation = params.get("generation")
            if type(generation) is not int or not 1 <= generation <= 65535:
                raise ValueError("Invalid recovery generation")
            stream = getattr(scope, "stream", None)
            if stream is None or not hasattr(stream, "ack_communication_recovery"):
                raise RuntimeError("Recovery transport unavailable")
            acknowledged = stream.ack_communication_recovery(generation)
            return {"ok": True, "acknowledged": acknowledged, "generation": generation}
        if action in {"mode", "set_mode"}:
            idx = int(params.get("idx", params.get("mode", 0)))
            if idx < 0 or idx > 7:
                raise ValueError("mode must be 0..7")
            if idx > 0:
                self.last_run_mode = idx
            btn = scope.num_group.button(idx)
            if btn is not None:
                btn.setChecked(True)
            scope._num_clicked(idx)
            mode6_via5_pending = bool(idx >= 6 and getattr(scope, "_mode6_via5_pending", False))
            try:
                if not mode6_via5_pending:
                    scope._on_num_clicked_extra(idx)
            except Exception:
                pass
            if idx == 5:
                self._apply_mode5_work_dc(f"api_mode_{idx}")
            elif idx > 0 and not mode6_via5_pending:
                _apply_default_dc_config(scope, reason=f"api_mode_{idx}:work", profile="work")
            return {"ok": True, "mode": idx, "pending": mode6_via5_pending, "via": 5 if mode6_via5_pending else None}
        if action in {"start", "connect"}:
            idx = int(params.get("idx", params.get("mode", self.last_run_mode)))
            if idx < 1 or idx > 7:
                idx = self.last_run_mode if 1 <= int(self.last_run_mode) <= 7 else 3
            self.last_run_mode = idx
            self._restore_tim2_for_start()
            btn = scope.num_group.button(idx)
            if btn is not None:
                btn.setChecked(True)
            scope._num_clicked(idx)
            mode6_via5_pending = bool(idx >= 6 and getattr(scope, "_mode6_via5_pending", False))
            try:
                if not mode6_via5_pending:
                    scope._on_num_clicked_extra(idx)
            except Exception:
                pass
            if idx == 5:
                self._apply_mode5_work_dc(f"api_start_{idx}")
            elif idx > 0 and not mode6_via5_pending:
                _apply_default_dc_config(scope, reason=f"api_start_{idx}:work", profile="work")
            return {"ok": True, "action": action, "mode": idx, "pending": mode6_via5_pending, "via": 5 if mode6_via5_pending else None}
        if action in {"stop", "disconnect"}:
            selected = self._stop_stream_keep_mode()
            return {"ok": True, "mode": selected, "stopped": True}
        if action in {"identify", "identify_device", "device_identification"}:
            return self._start_device_identification(params)
        if action in {"frequency", "freq", "set_freq"}:
            requested = int(params.get("hz", params.get("freq", 200)))
            if requested != 200:
                raise ValueError("BMI30 buffer rate is fixed at 200 Hz")
            scope._on_freq_change("200 Hz")
            return {"ok": True, "freq_hz": 200, "fixed": True}
        if action in {"avg", "avg_n", "set_avg"}:
            from bmi30_averaging import normalize_depth, set_depth
            rpi_n = normalize_depth(params.get("rpi_avg_n", getattr(scope, "rpi_avg_n", 1)))
            old_avg = scope.avg_n
            avg_n = _set_scope_avg_n(scope, params.get("avg_n", params.get("n", old_avg)))
            if avg_n != old_avg:
                scope._rt_detector_worker_reset_for_stream(reason="stm32_averaging")
                scope._on_avg_change(0)
            rpi_n = set_depth(scope, rpi_n)
            return {"ok": True, "avg_n": avg_n, "rpi_avg_n": rpi_n}
        if action in {"smoothing", "smooth", "smooth_mode", "set_smooth_mode"}:
            if not hasattr(scope, "_set_smooth_mode"):
                raise RuntimeError("engine does not support input smoothing")
            persist = _api_bool(params.get("persist", params.get("save", True)), True)
            snapshot = scope._set_smooth_mode(
                params.get("mode", params.get("value", 0)),
                persist=persist,
                announce=True,
            )
            return {"ok": True, "smoothing": snapshot, "persisted": persist}
        if action in {"det_ratio", "ratio", "set_det_ratio"}:
            val = float(params.get("value", params.get("ratio", 2.0)))
            if hasattr(scope, "_set_detector_channel_settings"):
                scope._set_detector_channel_settings({"ratio0": val, "ratio1": val})
            else:
                scope._on_det_ratio_change(f"{val:.1f}")
            try:
                scope.det_ratio_box.setCurrentText(f"{val:.1f}")
            except Exception:
                pass
            return {"ok": True, "det_ratio": float(getattr(scope, "_det_ratio", val))}
        if action in {"tag_detection", "detector_settings", "set_detector_settings", "set_tag_detection"}:
            if not hasattr(scope, "_set_detector_channel_settings"):
                raise RuntimeError("engine does not support per-channel detector settings")
            persist = _api_bool(params.get("persist", params.get("save", True)), True)
            snapshot = scope._set_detector_channel_settings(params, persist=persist)
            return {"ok": True, "detector": snapshot, "persisted": persist}
        if action in {"runtime_detector_settings", "runtime_tag_detection", "detector_thresholds", "set_detector_thresholds"}:
            if not hasattr(scope, "_set_detector_channel_settings"):
                raise RuntimeError("engine does not support per-channel detector settings")
            snapshot = scope._set_detector_channel_settings(params, persist=False)
            return {"ok": True, "detector": snapshot, "persisted": False}
        if action in {"tim2", "tx", "set_tim2"}:
            enabled = bool(params.get("enabled", params.get("value", True)))
            self._restore_tim2_valid = False
            try:
                scope.btn_tim2.setChecked(enabled)
            except Exception:
                pass
            scope._on_toggle_tim2(enabled)
            return {"ok": True, "tim2_enabled": enabled}
        if action in {"sync_mode", "sync_role", "set_sync_mode", "set_sync_role"}:
            role = str(params.get("role", params.get("mode", "")) or "").strip().lower()
            if role in {"0", "master", "m"}:
                role = "master"
                mode = 0
            elif role in {"1", "slave", "s"}:
                role = "slave"
                mode = 1
            else:
                raise ValueError("role assignment is required and must be master or slave")
            if not hasattr(scope, "_send_sync_mode"):
                raise RuntimeError("engine does not support forced sync role assignment")
            if not bool(scope._send_sync_mode(mode)):
                raise RuntimeError(f"failed to assign sync role {role}")
            assigned_at_ms = int(getattr(scope, "_last_sync_assignment_unix_ms", 0) or 0)
            return {
                "ok": True,
                "role": role,
                "assigned_at_unix_ms": assigned_at_ms,
                "persisted": True,
            }
        if action in {"rs485_id", "device_id", "set_rs485_id", "set_device_id"}:
            raw_device_id = params.get("device_id", params.get("node_id", params.get("value")))
            try:
                device_id = int(raw_device_id)
            except Exception as exc:
                raise ValueError("RS485 device ID must be an integer from 0 to 31") from exc
            if not 0 <= device_id <= 31:
                raise ValueError("RS485 device ID must be from 0 to 31")
            stream = getattr(scope, "stream", None)
            if stream is None or not hasattr(stream, "set_rs485_id"):
                raise RuntimeError("engine does not support persistent RS485 device ID assignment")
            if not bool(stream.set_rs485_id(device_id)):
                raise RuntimeError(f"failed to assign RS485 device ID {device_id:02d}")
            return {
                "ok": True,
                "device_id": device_id,
                "node_id": device_id,
                "device_id_assigned": True,
                "persisted": True,
            }
        if action in {"rpi_info", "set_rpi_info", "rs485_rpi_info"}:
            rpi_id = str(params.get("rpi_id", params.get("identifier", "")) or "").strip().upper()
            if re.fullmatch(r"[0-9A-F]{9}", rpi_id) is None:
                raise ValueError("RPI ID must be the 9-hex suffix from hostname BMI30-XXXXXXXXX")
            local_ip = str(params.get("ip", params.get("local_ip", "")) or "").strip()
            if not local_ip:
                raise ValueError("RPI IPv4 address is required")
            stream = getattr(scope, "stream", None)
            if stream is None or not hasattr(stream, "set_rpi_info"):
                raise RuntimeError("engine does not support RPI ID/IP publication")
            if not bool(stream.set_rpi_info(rpi_id, local_ip)):
                raise RuntimeError("failed to publish RPI ID/IP")
            time.sleep(0.02)
