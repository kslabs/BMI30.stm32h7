[Unit]
Description=BMI30 CM5 external antenna selection check
After=local-fs.target
ConditionPathExists=/proc/device-tree/model

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/bmi30-antenna-check.py --output /run/bmi30-antenna-check/status.json
RuntimeDirectory=bmi30-antenna-check
RuntimeDirectoryMode=0755
RemainAfterExit=yes
TimeoutStartSec=20
ProtectSystem=full
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
