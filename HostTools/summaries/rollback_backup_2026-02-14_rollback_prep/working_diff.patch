-             (unsigned long long)cur, (unsigned long)bps, (double)mbps,
-             (unsigned)streaming, (unsigned)diag_mode_active,
-             (unsigned long)dbg_sent_ch0_total, (unsigned long)dbg_sent_ch1_total, (unsigned long)stream_seq,
