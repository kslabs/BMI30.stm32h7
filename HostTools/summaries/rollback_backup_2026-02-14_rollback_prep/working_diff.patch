-    if (last_cmd_received == 0x20) {
-        snprintf(cmd_str, sizeof(cmd_str), "ST:%lu", (unsigned long)cmd_start_count);
-    } else if (last_cmd_received == 0x21) {
-        snprintf(cmd_str, sizeof(cmd_str), "SP:%lu", (unsigned long)cmd_stop_count);
