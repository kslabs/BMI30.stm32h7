-    #if DIAG_DISABLE_ADC_DMA
-        ADC_LOGF("[ADC][DIAG] DMA start suppressed (DIAG_DISABLE_ADC_DMA=1) total_samples=%lu\r\n", (unsigned long)total_samples);
-        return HAL_OK;
-    #else
-        // Старт ADC1 DMA на буфер[0] длиной N
