[Unit]
Description=BMI30 automatic service network and Internet routing
After=NetworkManager.service bmi30-hotspot.service bmi30-hotspot-info.service
Wants=NetworkManager.service bmi30-hotspot.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/bmi30-network/service.py
Restart=always
RestartSec=10
RuntimeDirectory=bmi30-network
StateDirectory=bmi30-network
UMask=0077
Nice=10
CPUWeight=20
MemoryMax=160M
TasksMax=48
ProtectHome=read-only
# The acquisition owner publishes its existing cache under /tmp.
# Read the shared directory, not a private namespace or a pinned file inode.
PrivateTmp=no
ReadOnlyPaths=/tmp
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
