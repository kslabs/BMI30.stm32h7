ARG BASE_IMAGE
FROM ${BASE_IMAGE}
# BASE_IMAGE must be the administrator-verified current r36 local image ID/digest.
# Keep its existing user/CMD/dependencies/ports; only add this reviewed source pair.
COPY --chown=10001:10002 bmi30hub/central_store.py /opt/bmi30hub/app/bmi30hub/central_store.py
COPY --chown=10001:10002 bmi30hub/main.py /opt/bmi30hub/app/bmi30hub/main.py
LABEL bmi30.central-wifi="candidate-v1" bmi30.captures-enabled="false"
