/* Беззнаковая разность тиков (учёт переполнения 32-битного HAL_GetTick()) */
static inline uint32_t tick_diff32(uint32_t now, uint32_t before){ return (now >= before) ? (now - before) : (0xFFFFFFFFu - before + 1u + now); }
